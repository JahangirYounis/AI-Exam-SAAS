@page
@model ForgotPasswordModel
@{ ViewData["Title"] = "Forgot Password"; }

<section class="auth-page py-5">
    <div class="container">
        <div class="auth-card auth-card-compact mx-auto bg-white p-4 p-lg-5">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="simple-brand mb-4"><span class="public-brand-mark"><i class="bi bi-journal-check"></i></span><strong>AI Based Online Examination System</strong></a>
            <div class="auth-icon"><i class="bi bi-key"></i></div>
            <h1 class="h2 fw-bold mt-3">Reset your password</h1>
            <p class="text-secondary">Enter your registered email address. We will send you a password reset link.</p>
            <form method="post" class="mt-4">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="mb-4"><label asp-for="Input.Email" class="form-label fw-semibold"></label><input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" placeholder="name@example.com"/><span asp-validation-for="Input.Email" class="text-danger small"></span></div>
                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-envelope me-2"></i>Send Reset Link</button>
            </form>
            <div class="text-center mt-4"><a asp-page="./Login"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a></div>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
