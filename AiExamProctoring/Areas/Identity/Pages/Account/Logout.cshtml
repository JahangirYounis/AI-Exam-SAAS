@page
@model LogoutModel
@{
    ViewData["Title"] = "Sign Out";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h2 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</h2>
                </div>
                <div class="card-body p-5 text-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <i class="bi bi-person-x-fill text-danger display-1 mb-4"></i>
                        <h4 class="fw-bold">Do you want to sign out?</h4>
                        <p class="text-muted mb-4">You will need to enter your email and password to use the system again.</p>
                        <form method="post">
                            <input type="hidden" name="returnUrl"
                                   value="@Url.Action("Index", "Home", new { area = "" })" />
                            <button type="submit" class="btn btn-danger btn-lg px-5">
                                <i class="bi bi-door-open-fill me-2"></i>Sign Out
                            </button>
                            <a asp-area="" asp-controller="Home" asp-action="Index"
                               class="btn btn-secondary btn-lg ms-2">
                                Cancel
                            </a>
                        </form>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill text-success display-1 mb-4"></i>
                        <h4 class="fw-bold text-success">You are already logged out.</h4>
                        <a asp-area="" asp-controller="Home" asp-action="Index"
                           class="btn btn-primary btn-lg mt-3">
                            <i class="bi bi-house-door-fill me-2"></i>Go to Home
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
