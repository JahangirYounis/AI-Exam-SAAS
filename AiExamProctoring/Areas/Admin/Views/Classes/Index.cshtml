@model List<AiExamProctoring.Models.AcademicClass>
@{
    ViewData["Title"] = "Class management";
    var teachers = ViewBag.Teachers as List<AiExamProctoring.Models.ApplicationUser> ?? new();
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h2 fw-bold mb-2">Class management</h1>
        <p class="text-secondary mb-0">Administrators control class creation, teacher assignments, rosters, transfers and archiving.</p>
    </div>
    <span class="badge text-bg-primary">Admin only</span>
</div>
<section class="card border-0 shadow-sm rounded-4 mb-4" aria-labelledby="createClassHeading">
    <div class="card-body p-4">
        <h2 id="createClassHeading" class="h5 fw-bold mb-3">Create a class</h2>
        <form asp-action="Create" method="post" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="newClassName" class="form-label">Class name</label>
                <input id="newClassName" name="name" required maxlength="120" class="form-control" placeholder="e.g. BSIT Semester VIII" />
            </div>
            <div class="col-md-5">
                <label for="newClassTeacher" class="form-label">Assigned teacher</label>
                <select id="newClassTeacher" name="teacherId" required class="form-select">
                    <option value="">Choose approved teacher</option>
                    @foreach (var teacher in teachers)
                    {
                        <option value="@teacher.Id">@teacher.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100" disabled="@(teachers.Count == 0)">Create class</button></div>
        </form>
    </div>
</section>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 fw-bold mb-0">Classes (@Model.Count)</h2>
    <span class="small text-secondary">@Model.Count(c => c.IsActive) active</span>
</div>
@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 p-4 text-secondary">No classes created yet.</div>
}
else
{
    <div class="row g-3">
    @foreach (var group in Model)
    {
        <div class="col-lg-6">
            <section class="card border-0 shadow-sm rounded-4 h-100" aria-labelledby="class-@group.Id">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h3 id="class-@group.Id" class="h5 fw-bold text-break mb-0">@group.Name</h3>
                        <span class="badge @(group.IsActive ? "text-bg-success" : "text-bg-secondary")">@(group.IsActive ? "Active" : "Archived")</span>
                    </div>
                    <p class="text-secondary small mb-3">Class #@group.Id · @group.Members.Count(m => m.IsActive) active student(s)</p>
                    <a asp-action="Roster" asp-route-id="@group.Id" class="btn btn-outline-primary btn-sm mb-3">Manage roster &amp; transfers</a>
                    <form asp-action="Configure" method="post" class="row g-2 align-items-end border-top pt-3">
                        <input type="hidden" name="id" value="@group.Id" />
                        <div class="col-sm-7">
                            <label class="form-label" for="teacher-@group.Id">Assigned teacher</label>
                            <select id="teacher-@group.Id" name="teacherId" class="form-select form-select-sm" required>
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.Id" selected="@(teacher.Id == group.TeacherId)">@teacher.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-5"><div class="form-check mb-2"><input class="form-check-input" id="active-@group.Id" type="checkbox" name="active" value="true" checked="@group.IsActive" /><label class="form-check-label" for="active-@group.Id">Active class</label></div><button type="submit" class="btn btn-sm btn-outline-secondary w-100">Save settings</button></div>
                    </form>
                    <details class="mt-3 border-top pt-3">
                        <summary class="small fw-semibold text-primary">Associate an unpublished examination</summary>
                        <form asp-action="AssociateExam" method="post" class="row g-2 align-items-end mt-1">
                            <input type="hidden" name="id" value="@group.Id" />
                            <div class="col-sm-7"><label class="form-label small" for="exam-@group.Id">Exam ID</label><input id="exam-@group.Id" type="number" min="1" name="examId" required class="form-control form-control-sm" /></div>
                            <div class="col-sm-5"><button type="submit" class="btn btn-sm btn-outline-primary w-100">Associate draft</button></div>
                        </form>
                    </details>
                </div>
            </section>
        </div>
    }
    </div>
}
