@model IEnumerable<AiExamProctoring.Models.ExamResult>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Exam Results";

    var totalResults = Model.Count();
    var passedResults = Model.Count(x => x.IsPassed);
    var failedResults = Model.Count(x => !x.IsPassed);

    decimal passPercentage =
        totalResults == 0
            ? 0m
            : Math.Round(
                (decimal)passedResults / totalResults * 100m,
                2);
}

<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

    <div>

        <h2 class="fw-bold mb-1">

            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>

            Exam Results

        </h2>

        <p class="text-muted mb-0">

            View and analyze examination results submitted by students.

        </p>

    </div>

</div>


<!-- ========================================================= -->
<!-- SUCCESS / ERROR -->
<!-- ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ========================================================= -->
<!-- STATISTICS -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">

    <!-- Total Exams -->

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow rounded-4 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        <small class="text-uppercase text-muted">
                            Total Exams
                        </small>

                        <h2 class="fw-bold mt-2 mb-1">
                            @ViewBag.TotalExams
                        </h2>

                        <small class="text-primary">
                            All Examinations
                        </small>

                    </div>

                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">

                        <i class="bi bi-journal-text fs-2 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Active Exams -->

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow rounded-4 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        <small class="text-uppercase text-muted">
                            Active Exams
                        </small>

                        <h2 class="fw-bold text-success mt-2 mb-1">
                            @ViewBag.ActiveExams
                        </h2>

                        <small class="text-success">
                            Scheduled / Running
                        </small>

                    </div>

                    <div class="bg-success bg-opacity-10 rounded-circle p-3">

                        <i class="bi bi-play-circle-fill fs-2 text-success"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Total Submissions -->

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow rounded-4 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        <small class="text-uppercase text-muted">
                            Total Submissions
                        </small>

                        <h2 class="fw-bold text-warning mt-2 mb-1">
                            @ViewBag.TotalSubmissions
                        </h2>

                        <small class="text-warning">
                            Completed Results
                        </small>

                    </div>

                    <div class="bg-warning bg-opacity-10 rounded-circle p-3">

                        <i class="bi bi-send-check-fill fs-2 text-warning"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Pass Percentage -->

    <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow rounded-4 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        <small class="text-uppercase text-muted">
                            Pass Percentage
                        </small>

                        <h2 class="fw-bold text-info mt-2 mb-1">

                            @passPercentage%

                        </h2>

                        <small class="text-info">

                            @passedResults Passed

                        </small>

                    </div>

                    <div class="bg-info bg-opacity-10 rounded-circle p-3">

                        <i class="bi bi-percent fs-2 text-info"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- FILTER CARD -->
<!-- ========================================================= -->

<div class="card border-0 shadow rounded-4 mb-4">

    <div class="card-header bg-white border-0 pt-4">

        <h5 class="fw-bold mb-0">

            <i class="bi bi-funnel-fill me-2"></i>

            Filter Results

        </h5>

    </div>

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="row g-3">

                <!-- Search -->

                <div class="col-lg-4">

                    <label class="form-label fw-semibold">

                        Search

                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Student or Exam..." />

                </div>


                <!-- Exam -->

                <div class="col-lg-4">

                    <label class="form-label fw-semibold">

                        Examination

                    </label>

                    <select name="examId"
                            class="form-select">

                        <option value="">

                            All Exams

                        </option>

                        @foreach (var exam in ViewBag.Exams)
                        {
                            <option value="@exam.ExamId"
                                    selected="@(ViewBag.SelectedExamId != null &&
                                                                                   ViewBag.SelectedExamId == exam.ExamId)">

                            @exam.ExamTitle

                            </option>
                                                }

                    </select>

                </div>


                <!-- Status -->

                <div class="col-lg-2">

                    <label class="form-label fw-semibold">

                        Status

                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">
                            All
                        </option>

                        <option value="Passed"
                                selected="@(ViewBag.SelectedStatus?.ToString() == "Passed")">

                            Passed

                        </option>

                        <option value="Failed"
                                selected="@(ViewBag.SelectedStatus?.ToString() == "Failed")">

                            Failed

                        </option>

                    </select>

                </div>


                <!-- Buttons -->

                <div class="col-lg-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search me-1"></i>

                        Filter

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- ========================================================= -->
<!-- RESULTS TABLE -->
<!-- ========================================================= -->

<div class="card border-0 shadow rounded-4">

    <div class="card-header bg-white border-0 pt-4">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="fw-bold mb-0">

                <i class="bi bi-list-check me-2"></i>

                Result List

            </h5>

            <span class="badge bg-primary rounded-pill px-3 py-2">

                @totalResults Results

            </span>

        </div>

    </div>


    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Student
                        </th>

                        <th>
                            Examination
                        </th>

                        <th>
                            Marks
                        </th>

                        <th>
                            Percentage
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Generated
                        </th>

                        <th class="text-center">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Any())
                    {
                        var counter = 1;

                        foreach (var result in Model)
                        {
                            decimal percentage =
                            result.TotalMarks == 0
                            ? 0m
                            : Math.Round(
                            (decimal)result.TotalMarksObtained
                            / result.TotalMarks
                            * 100m,
                            2);

                            <tr>

                                <!-- ID -->

                                <td>

                                    <span class="fw-bold text-primary">

                                        #@result.ResultId

                                    </span>

                                </td>


                                <!-- Student -->

                                <td>

                                    <div class="fw-semibold">

                                        @(result.Attempt?.Student?.FullName
                                                                        ?? "Unknown Student")

                            </div>

                            @if (result.Attempt?.Student != null)
                                    {
                                        <small class="text-muted">

                                            @result.Attempt.Student.Email

                                        </small>
                                    }

                        </td>


                        <!-- Exam -->

                        <td>

                            <div class="fw-semibold">

                                @(result.Attempt?.Exam?.ExamTitle
                                                                ?? "Unknown Exam")

                            </div>

                            @if (result.Attempt?.Exam != null)
                                    {
                                        <small class="text-muted">

                                            @result.Attempt.Exam.ExamDate.ToString("dd MMM yyyy")

                                        </small>
                                    }

                                </td>


                                <!-- Marks -->

                                <td>

                                    <span class="badge bg-dark rounded-pill px-3 py-2">

                                        @result.TotalMarksObtained /
                                        @result.TotalMarks

                                    </span>

                                </td>


                                <!-- Percentage -->

                                <td>

                                    <strong>

                                        @percentage%

                                    </strong>

                                </td>


                                <!-- Status -->

                                <td>

                                    @if (result.IsPassed)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Passed

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2">

                                            <i class="bi bi-x-circle-fill me-1"></i>

                                            Failed

                                        </span>
                                    }

                                </td>


                                <!-- Date -->

                                <td>

                                    <div>

                                        @result.GeneratedDate.ToString("dd MMM yyyy")

                                    </div>

                                    <small class="text-muted">

                                        @result.GeneratedDate.ToString("hh:mm tt")

                                    </small>

                                </td>


                                <!-- Action -->

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@result.ResultId"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-3">

                                        <i class="bi bi-eye-fill me-1"></i>

                                        Details

                                    </a>

                                </td>

                            </tr>

                            counter++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-5">

                                <i class="bi bi-clipboard-x display-1 text-secondary"></i>

                                <h3 class="mt-3">

                                    No Results Found

                                </h3>

                                <p class="text-muted">

                                    No examination results are available
                                    for the selected filters.

                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>