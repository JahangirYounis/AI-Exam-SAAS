@model AiExamProctoring.Models.Exam
@{
    ViewData["Title"] = "Historical Examination Record";
    var questions = Model.ExamQuestions.Where(x => x.IsActive && x.Question != null).OrderBy(x => x.Session?.DisplayOrder ?? 0).ThenBy(x => x.DisplayOrder).ToList();
}
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4 d-print-none"><div><span class="eyebrow">Exam record</span><h1 class="fw-bold mb-1">@Model.ExamTitle</h1><p class="text-secondary mb-0">@Model.StartDate.ToString("dddd, dd MMMM yyyy 'at' hh:mm tt") · @(Model.Post?.PostName ?? Model.Department?.DepartmentName ?? "General")</p></div><div class="d-flex gap-2"><button class="btn btn-outline-dark rounded-pill" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print / Save PDF</button><a asp-action="Index" class="btn btn-light border rounded-pill">Back</a></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="small text-secondary">Questions</div><div class="fs-3 fw-bold">@Model.TotalQuestions</div></div></div><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="small text-secondary">Candidates</div><div class="fs-3 fw-bold">@Model.Assignments.Count(x=>x.IsActive)</div></div></div><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="small text-secondary">Completed Attempts</div><div class="fs-3 fw-bold">@ViewBag.Completed</div></div></div><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="small text-secondary">Average %</div><div class="fs-3 fw-bold">@ViewBag.Average</div></div></div></div>
<div class="card border-0 shadow-sm rounded-4 p-3 p-lg-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h4 fw-bold mb-1">Question Paper Record</h2><div class="small text-secondary">Questions used in this released examination are locked in the master bank to preserve historical integrity.</div></div><span class="badge text-bg-primary rounded-pill px-3 py-2">@questions.Count questions</span></div>
@foreach(var group in questions.GroupBy(x=>x.Session?.SessionNumber ?? 0).OrderBy(x=>x.Key)){
  <h3 class="h6 text-primary fw-bold mt-4">@(group.Key==0?"Unassigned":"Session "+group.Key)</h3>
  @foreach(var eq in group){var q=eq.Question!;<div class="border rounded-4 p-3 mb-3"><div class="d-flex justify-content-between gap-3"><div class="fw-semibold">@eq.DisplayOrder. @q.QuestionText</div><span class="badge text-bg-light border">@eq.Marks.ToString("0.##") mark(s)</span></div><div class="small text-secondary mt-2">@q.Subject?.SubjectName @if(!string.IsNullOrWhiteSpace(q.Topic)){<span>· @q.Topic</span>}</div><div class="row g-2 small mt-2"><div class="col-md-6">A. @q.OptionA</div><div class="col-md-6">B. @q.OptionB</div><div class="col-md-6">C. @q.OptionC</div><div class="col-md-6">D. @q.OptionD</div>@if(!string.IsNullOrWhiteSpace(q.OptionE)){<div class="col-md-6">E. @q.OptionE</div>}</div><div class="mt-2"><strong>Correct answer:</strong> @q.CorrectAnswer</div></div>}
}
</div>

@await Component.InvokeAsync("ExamAudit", new { examId = Model.ExamId })
