@model AiExamProctoring.Models.ProctoringLog
@{
    ViewData["Title"] = "Evidence Details";
}
<link rel="stylesheet" href="~/css/incident-evidence-details.css" asp-append-version="true" />
<div class="incident-evidence">
    <header class="incident-evidence-header">
        <a asp-action="ExamFolder" asp-route-studentId="@Model.StudentId" asp-route-examId="@Model.ExamId" class="incident-evidence-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to evidence list
        </a>
        <h1>Evidence Details</h1>
        <dl class="incident-evidence-facts">
            <div><dt>Student ID</dt><dd>@(Model.Student?.CandidateNumber ?? Model.StudentId ?? "Unavailable")</dd></div>
            <div><dt>Student name</dt><dd>@(Model.Student?.FullName ?? "Unavailable")</dd></div>
            <div><dt>Exam</dt><dd>@(Model.Exam?.ExamTitle ?? "Unavailable")</dd></div>
            <div><dt>Incident type</dt><dd>@Model.AlertTypeDisplay</dd></div>
            <div><dt>Date and time</dt><dd><time datetime="@Model.CreatedDate.ToString("O")">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm:ss tt")</time></dd></div>
            @if (Model.WarningNumber is int warning)
            {
                <div><dt>Warning number</dt><dd>@warning</dd></div>
            }
        </dl>
    </header>
    <section class="incident-evidence-panel incident-evidence-access" aria-labelledby="shared-evidence-title">
        <h2 id="shared-evidence-title">Protected evidence</h2>
        <p>The exam owner can share selected video, audio and screenshots with your account.</p>
        <a asp-area="" asp-controller="SharedEvidence" asp-action="Index" class="btn btn-outline-primary btn-sm">Evidence shared with me</a>
    </section>
    <details class="incident-evidence-panel incident-evidence-technical">
        <summary>Technical Details</summary>
        <dl class="incident-evidence-facts">
            <div><dt>Incident ID</dt><dd>#@Model.LogId</dd></div>
            <div><dt>Attempt / session</dt><dd>#@(Model.AttemptId?.ToString() ?? "—") · @(Model.SessionAttempt?.Session?.SessionTitle ?? "Exam-level event")</dd></div>
            <div><dt>Severity</dt><dd>@Model.Severity</dd></div>
            <div><dt>Policy effect</dt><dd>@(Model.CountsAsViolation ? "Accepted violation" : "Observation / recovery")</dd></div>
            <div><dt>Review state</dt><dd>@(Model.IsReviewed ? "Reviewed" : "Review pending")</dd></div>
            <div><dt>Detected faces / confidence</dt><dd>@(Model.DetectedFaceCount?.ToString() ?? "—") / @(Model.ConfidenceScore.HasValue ? $"{Model.ConfidenceScore:P1}" : "—")</dd></div>
            <div><dt>Source</dt><dd>@(Model.ModelName ?? "Browser/system event") @Model.ModelVersion</dd></div>
            <div><dt>Description</dt><dd>@(Model.Description ?? "Unavailable")</dd></div>
        </dl>
    </details>
</div>
