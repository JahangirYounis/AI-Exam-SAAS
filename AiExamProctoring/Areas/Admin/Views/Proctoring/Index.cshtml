@model IReadOnlyCollection<AiExamProctoring.ViewModels.CandidateProctoringFolderViewModel>
@{
    ViewData["Title"] = "Proctoring Audit";
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <span class="eyebrow">Monitoring review</span>
        <h2 class="fw-bold mt-1 mb-1">Candidate Evidence Folders</h2>
        <p class="text-secondary mb-0">Every candidate has a separate folder; every examination is stored as a separate folder inside it.</p>
    </div>
    <form method="get" class="d-flex gap-2 proctor-search">
        <input name="search" value="@ViewBag.Search" class="form-control rounded-pill" placeholder="Candidate, ID, email or exam" />
        <button class="btn btn-primary rounded-pill px-4"><i class="bi bi-search me-1"></i>Find</button>
    </form>
</div>

<div class="alert alert-info border-0 rounded-4 mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    Admin can audit platform-wide evidence. Warning review and examination unblock decisions belong to the examination's Teacher.
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="metric-card h-100"><strong>@ViewBag.TotalCandidates</strong><span>Candidate folders</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card h-100"><strong>@ViewBag.TotalEvents</strong><span>Total events</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card h-100"><strong class="text-warning">@ViewBag.PendingEvents</strong><span>Teacher review pending</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card h-100"><strong class="text-primary">@ViewBag.EvidenceEvents</strong><span>Evidence files</span></div></div>
</div>

<div class="row g-4">
    @foreach (var folder in Model)
    {
        var imageUrl = string.IsNullOrWhiteSpace(folder.ProfileImage)
            ? Url.Content("~/images/default-user.svg")
            : Url.Content(folder.ProfileImage);
        <div class="col-md-6 col-xxl-4">
            <a asp-action="Candidate" asp-route-studentId="@folder.StudentId" class="proctor-folder-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <img src="@imageUrl" alt="@folder.CandidateName" class="proctor-folder-avatar" loading="lazy" />
                    <div class="min-w-0 flex-grow-1">
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-folder-fill text-warning fs-4"></i><strong class="text-truncate">@folder.CandidateName</strong></div>
                        <div class="small text-secondary text-truncate">@folder.CandidateNumber · @folder.Email</div>
                    </div>
                    <i class="bi bi-chevron-right text-secondary"></i>
                </div>
                <div class="proctor-folder-metrics">
                    <span><strong>@folder.ExamFolderCount</strong> exams</span>
                    <span><strong>@folder.AlertCount</strong> events</span>
                    <span><strong>@folder.EvidenceCount</strong> files</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="badge-soft @(folder.PendingCount > 0 ? "soft-warning" : "soft-success")">@folder.PendingCount pending</span>
                    <small class="text-secondary">@(folder.LatestEventAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "No activity")</small>
                </div>
            </a>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="col-12"><div class="dashboard-card"><div class="empty-state"><i class="bi bi-folder2-open"></i><h5 class="fw-bold mt-3">No candidate evidence folders</h5><p class="text-secondary mb-0">Folders are created automatically when an examination produces a proctoring event.</p></div></div></div>
    }
</div>

@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="Candidate folders pages"><ul class="pagination justify-content-center">
        <li class="page-item @(page <= 1 ? "disabled" : null)"><a class="page-link" asp-route-page="@(page - 1)" asp-route-search="@ViewBag.Search">Previous</a></li>
        @for (var i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
        { <li class="page-item @(i == page ? "active" : null)"><a class="page-link" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a></li> }
        <li class="page-item @(page >= totalPages ? "disabled" : null)"><a class="page-link" asp-route-page="@(page + 1)" asp-route-search="@ViewBag.Search">Next</a></li>
    </ul></nav>
}
