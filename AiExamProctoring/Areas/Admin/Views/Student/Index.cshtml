@model IEnumerable<AiExamProctoring.Models.ApplicationUser>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Student Management";

    var total = Model.Count();
    var approved = Model.Count(x => x.IsApproved);
    var blocked = Model.Count(x => x.IsBlocked);
    var pending = Model.Count(x => !x.IsApproved);
}
<div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Student Management
        </h2>
        <p class="text-muted mb-0">
            Manage registered students, approvals and account status.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        <i class="bi bi-exclamation-circle-fill me-2"></i>
        @TempData["Error"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow rounded-4 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Total Students</small>
                    <h2 class="fw-bold text-primary mb-0">@total</h2>
                </div>
                <i class="bi bi-people-fill display-6 text-primary opacity-75"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow rounded-4 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Approved</small>
                    <h2 class="fw-bold text-success mb-0">@approved</h2>
                </div>
                <i class="bi bi-patch-check-fill display-6 text-success opacity-75"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow rounded-4 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Pending</small>
                    <h2 class="fw-bold text-warning mb-0">@pending</h2>
                </div>
                <i class="bi bi-hourglass-split display-6 text-warning opacity-75"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow rounded-4 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Blocked</small>
                    <h2 class="fw-bold text-danger mb-0">@blocked</h2>
                </div>
                <i class="bi bi-lock-fill display-6 text-danger opacity-75"></i>
            </div>
        </div>
    </div>

</div>

<div class="card shadow border-0 rounded-4">

    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul me-2"></i>
                Student List
            </h5>

            <span class="badge bg-primary rounded-pill px-3 py-2">
                @Model.Count() Students
            </span>

        </div>
    </div>

    <div class="card-body">

        <form method="get" class="row g-3 mb-4">

            <div class="col-lg-3">
                <input name="search"
                       value="@Context.Request.Query["search"]"
                       class="form-control"
                       placeholder="Search name, email, CNIC or Candidate ID">
            </div>

            <div class="col-lg-2">
                <select name="department" class="form-select">
                    <option value="">Department</option>

                    @foreach (var item in (IEnumerable<string>)ViewBag.Departments)
                    {
                        <option selected="@(Context.Request.Query["department"]==item)"
                                value="@item">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-2">
                <select name="batch" class="form-select">
                    <option value="">Batch</option>

                    @foreach (var item in (IEnumerable<string>)ViewBag.Batches)
                    {
                        <option selected="@(Context.Request.Query["batch"]==item)"
                                value="@item">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-2">
                <select name="semester" class="form-select">
                    <option value="">Semester</option>

                    @foreach (var item in (IEnumerable<string>)ViewBag.Semesters)
                    {
                        <option selected="@(Context.Request.Query["semester"]==item)"
                                value="@item">
                            @item
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-1 d-grid">
                <button class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            <div class="col-lg-2 d-grid">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Reset
                </a>
            </div>

        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Candidate ID</th>
                        <th>Department</th>
                        <th>Batch</th>
                        <th>Semester</th>
                        <th>Approval</th>
                        <th>Account</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-primary text-white fw-bold d-flex justify-content-center align-items-center me-3"
                                         style="width:45px;height:45px;">

                                        @(string.IsNullOrWhiteSpace(item.FullName)
                                                                        ? "?"
                                                                        : item.FullName.Substring(0, 1).ToUpper())

                                    </div>

                                    <div>

                                        <div class="fw-semibold">
                                            @item.FullName
                                        </div>

                                        <small class="text-muted">
                                            @item.Email
                                        </small>

                                    </div>

                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.CandidateNumber)
                                                        ? "Pending migration"
                                                        : item.CandidateNumber)
                                                                      </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Department)
                                                        ? "-"
                                                        : item.Department)
                                                                      </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Batch)
                                                        ? "-"
                                                        : item.Batch)
                                                                 </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Semester)
                                                        ? "-"
                                                        : item.Semester)
                    </td>

                            <td>

                        @if (item.IsApproved)
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.IsBlocked)
                                {
                                    <span class="badge bg-danger">
                                        Blocked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="btn-group">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @if (!item.IsApproved)
                                    {
                                        <form asp-action="Approve"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-success btn-sm"
                                                    onclick="return confirm('Approve this student?')">

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </form>
                                    }

                                    @if (item.IsBlocked)
                                    {
                                        <form asp-action="Unblock"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-primary btn-sm"
                                                    onclick="return confirm('Unblock this student?')">

                                                <i class="bi bi-unlock"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Block"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    onclick="return confirm('Block this student?')">

                                                <i class="bi bi-lock"></i>

                                            </button>

                                        </form>
                                    }

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Delete">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8" class="text-center py-5">

                            <i class="bi bi-people display-4 text-secondary"></i>

                            <h5 class="mt-3">
                                No Students Found
                            </h5>

                            <p class="text-muted mb-0">
                                No student matches your search criteria.
                            </p>

                        </td>

                    </tr>
                }

                </tbody>
            </table>
        </div>
    </div>
</div>
