@model AiExamProctoring.Models.ExamAttempt
@{
    ViewData["Title"] = "Review Examination Paper";
    var student = Model.Student;
    var exam = Model.Exam;
    var sessions = Model.SessionAttempts.OrderBy(x => x.Session?.DisplayOrder).ThenBy(x => x.SessionAttemptId).ToList();
    var allAnswers = sessions.SelectMany(x => x.Answers).ToList();
    var answered = allAnswers.Count(x => !string.IsNullOrWhiteSpace(x.SelectedOption));
    var correct = allAnswers.Count(x => x.IsCorrect == true);
    var wrong = allAnswers.Count(x => x.IsCorrect == false);
    var skipped = allAnswers.Count(x => string.IsNullOrWhiteSpace(x.SelectedOption));
}
<div class="page-head">
    <div>
        <div class="eyebrow">Student paper review</div>
        <h1>@(exam?.ExamTitle ?? "Examination")</h1>
        <p>Review the candidate's saved answers, scoring outcome and session-by-session activity.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (student != null)
        {
            <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Student Details</a>
        }
        @if (Model.Result != null)
        {
            <a asp-area="Admin" asp-controller="Results" asp-action="Details" asp-route-id="@Model.Result.ResultId" class="btn btn-primary"><i class="bi bi-bar-chart me-1"></i>Result Details</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="card p-3 h-100"><small class="text-muted">Candidate</small><strong class="fs-5 mt-1">@(student?.FullName ?? "Unknown")</strong><span class="small text-muted">@(student?.RollNumber ?? student?.CandidateNumber ?? student?.Email)</span></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card p-3 h-100"><small class="text-muted">Attempt Status</small><strong class="fs-5 mt-1">@Model.Status</strong><span class="small text-muted">Started @Model.StartedAt.ToString("dd MMM yyyy, hh:mm tt")</span></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card p-3 h-100"><small class="text-muted">Score</small><strong class="fs-5 mt-1">@Model.TotalMarksObtained / @Model.TotalMarks</strong><span class="small text-muted">@Model.Percentage.ToString("0.##")% • @(Model.IsPassed ? "Passed" : "Failed")</span></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card p-3 h-100"><small class="text-muted">Responses</small><strong class="fs-5 mt-1">@answered / @allAnswers.Count</strong><span class="small text-muted">@correct correct • @wrong wrong • @skipped skipped</span></div></div>
</div>

@if (Model.IsDisqualified || Model.TotalViolations > 0)
{
    <div class="alert @(Model.IsDisqualified ? "alert-danger" : "alert-warning") modern-alert mb-4">
        <div class="d-flex align-items-start gap-3"><i class="bi bi-shield-exclamation fs-4"></i><div><strong>Proctoring summary</strong><div class="small">@Model.TotalViolations total violation(s), @Model.HighSeverityViolations high-severity. @(Model.IsDisqualified ? "This attempt is marked as disqualified." : "Review security logs before making an integrity decision.")</div></div></div>
    </div>
}

@if (!sessions.Any())
{
    <div class="card empty-state"><div class="empty-icon"><i class="bi bi-file-earmark-x"></i></div><h4>No session attempts found</h4><p>This attempt has no stored session/answer data to review.</p></div>
}
else
{
    foreach (var sessionAttempt in sessions)
    {
        var session = sessionAttempt.Session;
        var answers = sessionAttempt.Answers.OrderBy(x => x.Question?.DisplayOrder).ThenBy(x => x.AnswerId).ToList();
        <div class="card mb-4 overflow-hidden">
            <div class="card-header bg-white p-3 p-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div><div class="eyebrow mb-1">SESSION @(session?.SessionNumber ?? session?.DisplayOrder ?? 0)</div><h4 class="mb-0">@(session?.SessionTitle ?? "Exam Session")</h4></div>
                <div class="d-flex gap-2 flex-wrap"><span class="badge text-bg-light border">@sessionAttempt.Status</span><span class="badge text-bg-light border">@sessionAttempt.MarksObtained / @sessionAttempt.TotalMarks marks</span><span class="badge text-bg-success">@sessionAttempt.CorrectAnswers correct</span><span class="badge text-bg-danger">@sessionAttempt.WrongAnswers wrong</span><span class="badge text-bg-secondary">@sessionAttempt.SkippedAnswers skipped</span></div>
            </div>
            <div class="card-body p-3 p-lg-4">
                @if (!answers.Any())
                {
                    <p class="text-muted mb-0">No answers were stored for this session.</p>
                }
                else
                {
                    var qNo = 0;
                    foreach (var answer in answers)
                    {
                        qNo++;
                        var q = answer.Question;
                        if (q == null) { continue; }
                        var optionMap = new List<(string Key, string? Text)> { ("A", q.OptionA), ("B", q.OptionB), ("C", q.OptionC), ("D", q.OptionD), ("E", q.OptionE) };
                        <div class="paper-question @(qNo < answers.Count ? "border-bottom" : "") pb-4 mb-4">
                            <div class="d-flex justify-content-between gap-3 mb-3"><div class="d-flex gap-2"><span class="question-number">@qNo</span><h5 class="mb-0 lh-base">@q.QuestionText</h5></div><div>@if (answer.IsCorrect == true) { <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>Correct</span> } else if (answer.IsCorrect == false) { <span class="badge text-bg-danger"><i class="bi bi-x-circle me-1"></i>Wrong</span> } else { <span class="badge text-bg-secondary">Skipped</span> }</div></div>
                            <div class="row g-2">
                                @foreach (var option in optionMap.Where(x => !string.IsNullOrWhiteSpace(x.Text)))
                                {
                                    var isSelected = string.Equals(answer.SelectedOption, option.Key, StringComparison.OrdinalIgnoreCase);
                                    var isCorrectOption = string.Equals(q.CorrectAnswer, option.Key, StringComparison.OrdinalIgnoreCase);
                                    var css = isCorrectOption ? "review-option correct" : isSelected ? "review-option selected-wrong" : "review-option";
                                    <div class="col-md-6"><div class="@css"><b>@option.Key</b><span>@option.Text</span>@if (isCorrectOption) { <i class="bi bi-check-circle-fill ms-auto"></i> } else if (isSelected) { <i class="bi bi-person-check-fill ms-auto"></i> }</div></div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-3 small mt-3 text-muted"><span><b>Selected:</b> @(answer.SelectedOption ?? "Not answered")</span><span><b>Correct:</b> @q.CorrectAnswer</span><span><b>Marks:</b> @answer.MarksAwarded</span>@if (answer.IsMarkedForReview) { <span class="text-warning"><i class="bi bi-bookmark-fill me-1"></i>Marked for review</span> }</div>
                            @if (!string.IsNullOrWhiteSpace(q.Explanation)) { <div class="alert alert-light border mt-3 mb-0"><strong>Explanation:</strong> @q.Explanation</div> }
                        </div>
                    }
                }
            </div>
        </div>
    }
}
