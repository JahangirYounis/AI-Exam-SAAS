@model IReadOnlyCollection<AiExamProctoring.Models.ExamResult>
@using AiExamProctoring.Models

@{
    ViewData["Title"] = "Exam results";

    var exams = ViewBag.Exams as IEnumerable<AiExamProctoring.Models.Exam>
        ?? Array.Empty<AiExamProctoring.Models.Exam>();

    int? selectedId = ViewBag.ExamId is int examId
        ? examId
        : null;

    string selectedStatus = ViewBag.Status as string ?? "all";
    string search = ViewBag.Search as string ?? "";

    int currentPage = ViewBag.Page is int value ? value : 1;
    int totalPages = ViewBag.Pages is int total ? total : 1;

    int count = ViewBag.Count is int rows ? rows : 0;
    int graded = ViewBag.GradedCount is int g ? g : 0;
    int released = ViewBag.PublishedCount is int p ? p : 0;
    int withheld = ViewBag.PendingCount is int w ? w : 0;
    int passed = ViewBag.PassCount is int pc ? pc : 0;

    decimal average = ViewBag.AveragePercentage is decimal av
        ? av
        : 0m;

    int rowNumber = (currentPage - 1) * 25;
}

<div class="tw14-workspace tw14-results">

    <header class="tw14-hero">
        <div>
            <span class="tw14-eyebrow">
                <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                Examination performance
            </span>

            <h1>Results</h1>

            <p>
                Review academic performance, release decisions
                and candidate reports for your exams.
            </p>
        </div>

        @if (selectedId.HasValue)
        {
            <a asp-action="DownloadList"
               asp-route-examId="@selectedId"
               class="tw14-hero-button">

                <i class="bi bi-file-earmark-pdf"
                   aria-hidden="true"></i>

                Download result list
            </a>
        }
    </header>

    <section class="tw14-kpi-grid"
             aria-label="Result statistics">

        <div class="tw14-kpi">
            <span class="tw14-kpi-icon">
                <i class="bi bi-clipboard-check"></i>
            </span>

            <strong>@graded</strong>
            <span>Graded attempts</span>
        </div>

        <div class="tw14-kpi">
            <span class="tw14-kpi-icon is-green">
                <i class="bi bi-check-circle"></i>
            </span>

            <strong>@released</strong>
            <span>Published results</span>
        </div>

        <div class="tw14-kpi">
            <span class="tw14-kpi-icon is-amber">
                <i class="bi bi-hourglass-split"></i>
            </span>

            <strong>@withheld</strong>
            <span>Pending release</span>
        </div>

        <div class="tw14-kpi">
            <span class="tw14-kpi-icon is-indigo">
                <i class="bi bi-percent"></i>
            </span>

            <strong>@average.ToString("0.##")%</strong>

            <span>
                Published average · @passed passed
            </span>
        </div>

    </section>

    <section class="tw14-panel"
             aria-label="Filter exam results">

        <div class="tw14-panel-header">

            <div>
                <h2 class="tw14-section-title">
                    Candidate results
                </h2>

                <p class="tw14-muted">
                    A graded result is not visible to students
                    until published.
                </p>
            </div>

            @if (selectedId.HasValue)
            {
                <a asp-controller="ResultReview"
                   asp-action="Index"
                   asp-route-examId="@selectedId"
                   class="btn btn-outline-primary btn-sm">

                    <i class="bi bi-clipboard2-check"
                       aria-hidden="true"></i>

                    Review &amp; publish
                </a>
            }

        </div>

        <form asp-action="Index"
              method="get"
              class="tw14-filter-form"
              role="search">

            <div>
                <label for="tw14-result-exam"
                       class="form-label">
                    Examination
                </label>

                <select name="examId"
                        id="tw14-result-exam"
                        class="form-select">

                    @foreach (var exam in exams)
                    {
                        <option value="@exam.ExamId"
                                selected="@(exam.ExamId == selectedId)">
                            @exam.ExamTitle
                        </option>
                    }

                </select>
            </div>

            <div>
                <label for="tw14-result-search"
                       class="form-label">
                    Find student
                </label>

                <input id="tw14-result-search"
                       name="search"
                       type="search"
                       value="@search"
                       maxlength="100"
                       class="form-control"
                       placeholder="Student name or candidate number" />
            </div>

            <input type="hidden"
                   name="status"
                   value="@selectedStatus" />

            <div>
                <button type="submit"
                        class="btn btn-primary tw14-search-submit">

                    <i class="bi bi-search"
                       aria-hidden="true"></i>

                    Search
                </button>
            </div>

        </form>

        <nav class="tw14-tabs"
             aria-label="Result publication status">

            <a asp-action="Index"
               asp-route-examId="@selectedId"
               asp-route-search="@search"
               asp-route-status="all"
               class="@(selectedStatus == "all" ? "active" : "")"
               aria-current="@(selectedStatus == "all" ? "page" : null)">

                All
                <span>@graded</span>
            </a>

            <a asp-action="Index"
               asp-route-examId="@selectedId"
               asp-route-search="@search"
               asp-route-status="released"
               class="@(selectedStatus == "released" ? "active" : "")"
               aria-current="@(selectedStatus == "released" ? "page" : null)">

                Published
                <span>@released</span>
            </a>

            <a asp-action="Index"
               asp-route-examId="@selectedId"
               asp-route-search="@search"
               asp-route-status="withheld"
               class="@(selectedStatus == "withheld" ? "active" : "")"
               aria-current="@(selectedStatus == "withheld" ? "page" : null)">

                Pending release
                <span>@withheld</span>
            </a>

        </nav>

        @if (Model.Count == 0)
        {
            <div class="tw14-empty tw14-empty-inline">

                <i class="bi bi-clipboard2-data"
                   aria-hidden="true"></i>

                <h3>No matching results</h3>

                <p>
                    Try another examination or filter.
                    Finalized results appear when grading
                    has been recorded.
                </p>

                <a asp-controller="Exam"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">

                    My examinations
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle tw14-table">

                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Student</th>
                            <th scope="col">Academic marks</th>
                            <th scope="col">Outcome</th>
                            <th scope="col">Publication</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var result in Model)
                        {
                            rowNumber++;

                            bool isReleased =
                            result.Attempt?.ResultReleasedAtUtc != null;

                            <tr>

                                <td class="text-secondary">
                                    @rowNumber
                                </td>

                                <td>
                                    <strong>
                                        @result.Attempt?.Student?.FullName
                                    </strong>

                                    <div class="tw14-muted small">
                                        @(result.Attempt?.Student?.CandidateNumber ?? "No candidate number")
                                        · Attempt #@result.AttemptId
                                    </div>
                                </td>

                                <td>
                                    <strong>
                                        @result.TotalMarksObtained.ToString("0.##")
                                        /
                                        @result.TotalMarks.ToString("0.##")
                                    </strong>

                                    <div class="tw14-muted small">
                                        @result.Percentage.ToString("0.##")%
                                    </div>
                                </td>

                                <td>
                                    <span class="tw14-status @(result.IsPassed ? "is-passed" : "is-failed")">
                                        @(result.IsPassed ? "Passed" : "Below pass mark")
                                    </span>
                                </td>

                                <td>
                                    <span class="tw14-status @(isReleased ? "is-released" : "is-pending")">
                                        @(isReleased ? "Published" : "Not released")
                                    </span>

                                    <div class="tw14-muted small">
                                        @(isReleased
                                                                        ? result.Attempt!.ResultReleasedAtUtc!.Value.ToString("dd MMM yyyy")
                                                                        : "Teacher review may be required")
                            </div>
                        </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@result.ResultId"
                                       class="btn btn-outline-primary btn-sm">

                                        Details
                                    </a>
                                </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>

            <nav class="tw14-pages"
                 aria-label="Result pages">

                <span class="tw14-muted small">
                    Showing
                    @((currentPage - 1) * 25 + 1)–@(Math.Min(currentPage * 25, count))
                    of @count
                    · Page @(currentPage) of @(totalPages)
                </span>

                <div class="tw14-inline-actions">

                    @if (currentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-examId="@selectedId"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-page="@(currentPage - 1)"
                           class="btn btn-outline-primary btn-sm">

                            Previous
                        </a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Index"
                           asp-route-examId="@selectedId"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-page="@(currentPage + 1)"
                           class="btn btn-outline-primary btn-sm">

                            Next
                        </a>
                    }

                </div>

            </nav>
        }

    </section>

</div>
