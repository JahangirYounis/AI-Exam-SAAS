@model AiExamProctoring.Models.ExamResult
@{
    ViewData["Title"] = "Candidate result details";
    bool isReleased = Model.Attempt?.ResultReleasedAtUtc != null;
    var answerRows = ViewBag.AnswerRows as IEnumerable<AiExamProctoring.ViewModels.Student.ResultAnswerRow>
        ?? Array.Empty<AiExamProctoring.ViewModels.Student.ResultAnswerRow>();
}
<div class="tw14-workspace tw14-results">
    <nav aria-label="Breadcrumb" class="tw14-back"><a asp-action="Index" asp-route-examId="@Model.Attempt?.ExamId"><i class="bi bi-arrow-left" aria-hidden="true"></i> All results</a></nav>
    <header class="tw14-hero">
        <div><span class="tw14-eyebrow"><i class="bi bi-clipboard-data" aria-hidden="true"></i> Candidate result · Attempt #@Model.AttemptId</span>
            <h1>@Model.Attempt?.Student?.FullName</h1><p>@Model.Attempt?.Exam?.ExamTitle · @Model.Attempt?.Student?.CandidateNumber</p></div>
        <span class="tw14-hero-chip">@(isReleased ? "Published to student" : "Internal result · not released")</span>
    </header>
    <section class="tw14-kpi-grid" aria-label="Academic result summary">
        <div class="tw14-kpi"><span class="tw14-kpi-icon"><i class="bi bi-award"></i></span><strong>@Model.TotalMarksObtained.ToString("0.##") / @Model.TotalMarks.ToString("0.##")</strong><span>Academic marks</span></div>
        <div class="tw14-kpi"><span class="tw14-kpi-icon is-indigo"><i class="bi bi-percent"></i></span><strong>@Model.Percentage.ToString("0.##")%</strong><span>Percentage</span></div>
        <div class="tw14-kpi"><span class="tw14-kpi-icon is-green"><i class="bi bi-check-circle"></i></span><strong>@Model.CorrectAnswers</strong><span>Correct answers</span></div>
        <div class="tw14-kpi"><span class="tw14-kpi-icon is-amber"><i class="bi bi-dash-circle"></i></span><strong>@Model.SkippedAnswers</strong><span>Unanswered · @Model.WrongAnswers wrong</span></div>
    </section>
    <section class="tw14-panel">
        <div class="tw14-panel-header"><div><h2 class="tw14-section-title">Review and documentation</h2><p class="tw14-muted">Academic marks and monitoring observations are recorded separately.</p></div><span class="tw14-status @(Model.IsPassed ? "is-passed" : "is-failed")">@(Model.IsPassed ? "Passed" : "Below pass mark")</span></div>
        <div class="tw14-inline-actions">
            <a asp-controller="Monitoring" asp-action="ExamFolder" asp-route-examId="@Model.Attempt?.ExamId" asp-route-studentId="@Model.Attempt?.StudentId" asp-route-attemptId="@Model.AttemptId" class="btn btn-outline-primary"><i class="bi bi-shield-check" aria-hidden="true"></i> Evidence review</a>
            <a asp-controller="ResultReview" asp-action="Index" asp-route-examId="@Model.Attempt?.ExamId" class="btn btn-outline-primary"><i class="bi bi-clipboard2-check" aria-hidden="true"></i> Publication review</a>
        </div>
    </section>
    <section class="tw14-panel mt-3">
        <h2 class="tw14-section-title mb-3">Saved academic answers</h2>
        <partial name="~/Areas/Student/Views/Result/_AnswerRows.cshtml" model="answerRows" />
    </section>
    <section class="tw14-panel mt-3" aria-label="Certificate and result statement">
        <h2 class="tw14-section-title">Certificate / result statement</h2>
        <p class="tw14-muted">Incomplete or interrupted examinations receive an appropriate result statement; a block does not imply successful exam completion.</p>
        @if (isReleased && Model.Attempt?.ResultReviewedBy == null)
        {
            <form asp-controller="Certificates" asp-action="Approve" method="post" class="tw14-decision-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ResultId" />
                <label for="tw14-approval-reason" class="form-label">Reason for issuance review</label>
                <textarea id="tw14-approval-reason" name="reason" class="form-control" minlength="10" maxlength="1000" required></textarea>
                <button type="submit" class="btn btn-primary mt-2">Approve for issuance</button>
            </form>
        }
        @if (Model.CertificateReference != null)
        {
            <p class="tw14-muted">Certificate issued @Model.CertificateIssuedAtUtc · @(Model.CertificateRevokedAtUtc.HasValue ? "Revoked" : "Currently valid")</p>
            @if (!Model.CertificateRevokedAtUtc.HasValue)
            {
                <details class="tw14-danger-details">
                    <summary>Revoke certificate</summary>
                    <form asp-controller="Certificates" asp-action="Revoke" method="post" class="tw14-decision-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ResultId" />
                        <label for="tw14-revoke-reason" class="form-label">Revocation reason</label>
                        <textarea id="tw14-revoke-reason" name="reason" class="form-control" minlength="10" maxlength="1000" required></textarea>
                        <button type="submit" class="btn btn-outline-danger mt-2">Confirm revocation</button>
                    </form>
                </details>
            }
        }
    </section>
</div>
