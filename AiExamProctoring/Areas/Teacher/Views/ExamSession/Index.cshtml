@model IEnumerable<AiExamProctoring.Models.ExamSession>
@{var exam=(AiExamProctoring.Models.Exam)ViewBag.Exam;ViewData["Title"]="Exam Sessions";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">Exam sessions</span><h2 class="fw-bold mt-1">@exam.ExamTitle • Sessions</h2><p class="text-secondary mb-0">Questions and time are divided automatically from the selected exam paper.</p></div><a asp-controller="Exam" asp-action="Details" asp-route-id="@exam.ExamId" class="btn btn-light rounded-pill">Back</a></div>
<div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3"><div><b>Selected questions: @exam.TotalQuestions</b><div class="text-secondary small">Requested sessions: @exam.NumberOfSessions • Total time: @exam.DurationMinutes minutes</div></div><form asp-action="Generate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="examId" value="@exam.ExamId"/><button class="btn btn-primary rounded-pill px-4">Generate / Rebalance Sessions</button></form></div></div>
<div class="row g-3">@foreach(var s in Model){<div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4"><div class="d-flex justify-content-between"><span class="badge text-bg-primary">Session @s.SessionNumber</span><span class="text-muted">@s.DurationMinutes min</span></div><h4 class="fw-bold mt-3">@s.TotalQuestions MCQs</h4><p class="text-secondary">@s.TotalMarks marks</p><hr/><a asp-controller="ExamSessionSubject" asp-action="Index" asp-route-sessionId="@s.SessionId" class="btn btn-outline-dark btn-sm rounded-pill">View subject distribution</a></div></div></div>}</div>
