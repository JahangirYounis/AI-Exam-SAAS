@model AiExamProctoring.Models.Exam
@{
    ViewData["Title"] = "Create a test";
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div><h1 class="h3 fw-bold">Create a test</h1><p class="text-secondary mb-0">Save the details, choose questions, then review and publish. Your draft stays private until you publish. After saving, invite multiple co-teachers from the paper builder to prepare questions and monitor the exam together.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">All tests</a>
</div>
<form asp-action="Create" method="post" id="teacherExamForm" asp-antiforgery="false" data-prevent-double-submit="false">
    @Html.AntiForgeryToken()
    <partial name="_ExamForm" model="Model" />
    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-light border">Cancel</a><button type="submit" class="btn btn-primary px-4">Save &amp; choose questions</button></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/teacher-exam-form.js" asp-append-version="true" defer></script>
}
