@model AiExamProctoring.Models.Exam
@{
    ViewData["Title"] = "Create a test";
}
<div class="te-page-header"><div><span class="te-eyebrow">TEACHER EXAMINATIONS</span><h1>Create a test</h1><p>Choose the test type, eligible students, details, schedule and monitoring. Build the paper next.</p></div>
<a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>My examinations</a></div>
<form asp-action="Create" method="post" asp-antiforgery="false" id="teacherExamForm" class="te-exam-wizard" data-server-now="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" data-prevent-double-submit="true">
    @Html.AntiForgeryToken()
    <partial name="_ExamForm" model="Model" />
    <div class="te-wizard-submit"><a asp-action="Index" class="btn btn-light border">Cancel</a><button type="submit" class="btn btn-primary px-4" data-wizard-submit><i class="bi bi-check2-circle me-1"></i>Save draft &amp; choose MCQs</button></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/teacher-exam-form.js" asp-append-version="true" defer></script>
    <script src="~/js/teacher-picker.js" asp-append-version="true" defer></script>
}
