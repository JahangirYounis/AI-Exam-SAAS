@model AiExamProctoring.Models.Exam
@{ ViewData["Title"] = "Edit test details"; }
<div class="te-page-header"><div><span class="te-eyebrow">DRAFT EXAM</span><h1>Edit test details</h1><p>Change the draft settings. Session timing is configured separately after selecting questions.</p></div>
<a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to test</a></div>
<form asp-action="Edit" asp-route-id="@Model.ExamId" method="post" asp-antiforgery="false" id="teacherExamForm" class="te-exam-wizard" data-server-now="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" data-prevent-double-submit="true">
    @Html.AntiForgeryToken()
    <input asp-for="ExamId" type="hidden" />
    <partial name="_ExamForm" model="Model" />
    <div class="te-wizard-submit"><a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-light border">Cancel</a><button type="submit" class="btn btn-primary px-4" data-wizard-submit>Save changes</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/teacher-exam-form.js" asp-append-version="true" defer></script> }
