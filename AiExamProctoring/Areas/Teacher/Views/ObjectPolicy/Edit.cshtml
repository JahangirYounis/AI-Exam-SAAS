@model AiExamProctoring.Services.Proctoring.ExamObjectPolicy
@using AiExamProctoring.Services.Proctoring
@{ViewData["Title"]="Examination Object Rules";var supported=ViewBag.Supported as List<string> ?? new();}
<h1>Object rules — @ViewBag.ExamName</h1>
<p>Checked categories are prohibited in this examination. Recognition support and examination rules are separate. Current observations require teacher review: the installed detector cannot reliably prove physical presence, smartwatch type, or object use.</p>
<p>Items visible at startup are never automatically allowed. Ordinary watches and classroom furniture are not treated as prohibited device classes.</p>
<form method="post">
 @Html.AntiForgeryToken()<input type="hidden" name="id" value="@ViewBag.ExamId" />
 @foreach(var item in ProctoringObjectPolicy.Names){
  <div class="form-check"><input class="form-check-input" type="checkbox" id="category-@item.Key" name="prohibited" value="@item.Key" checked="@Model.Prohibited.Contains(item.Key)" /><label for="category-@item.Key">@item.Value — @(!supported.Contains(item.Key) ? "Unsupported by the installed model" : ProctoringObjectPolicy.CanConfirmAutomatically(item.Key) ? "Automatic monitoring available" : "Teacher review only")</label></div>
 }
 <label>Confirmation seconds <input name="confirmationSeconds" type="number" step="0.5" min="0.5" max="10" value="@Model.ConfirmationSeconds" /></label>
 <label>Fresh samples <input name="confirmationSamples" type="number" min="2" max="10" value="@Model.ConfirmationSamples" /></label>
 <label>Recovery seconds <input name="recoverySeconds" type="number" min="2" max="15" value="@Model.RecoverySeconds" /></label>
 <button type="submit" class="btn btn-primary">Save examination object rules</button>
</form>
<p>Version: @Model.Version. Class-specific confidence settings remain server-managed and require validation on labeled examples.</p>
