@model List<AiExamProctoring.Models.ExamInvigilator>
@{var exam=(AiExamProctoring.Models.Exam)ViewBag.Exam;ViewData["Title"]="Invite invigilators";}
<h1>Invite teachers — @exam.ExamTitle</h1><p>Invited teachers must accept before they can watch candidates or review evidence.</p>
<a class="btn btn-outline-primary" asp-action="Team" asp-route-examId="@exam.ExamId">Team discussion</a><form asp-action="Invite" method="post" class="d-flex flex-wrap gap-2 mb-3"><input type="hidden" name="examId" value="@exam.ExamId"/><textarea name="email" required class="form-control" rows="3" aria-label="Teacher emails" placeholder="Registered teacher emails, separated by commas or new lines"></textarea><label><input type="checkbox" name="canEditQuestions" value="true" checked /> Question addition and selection</label><label><input type="checkbox" name="canMonitor" value="true" checked /> Live monitoring and review</label><button class="btn btn-primary">Send invitation</button></form>
@foreach(var i in Model){<div class="card p-3 mb-2">@i.Teacher?.FullName — @(i.RevokedAtUtc.HasValue ? "Revoked" : i.IsActive ? "Accepted" : "Pending") · Questions: @i.CanEditQuestions · Monitoring: @i.CanMonitor<form asp-action="Revoke" method="post"><input type="hidden" name="id" value="@i.Id"/><button class="btn btn-outline-danger btn-sm">Revoke access</button></form></div>}
