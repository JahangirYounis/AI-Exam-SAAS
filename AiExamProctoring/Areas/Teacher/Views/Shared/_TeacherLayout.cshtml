@inject AiExamProctoring.Data.ApplicationDbContext TeacherDb
@using Microsoft.EntityFrameworkCore
@inject Microsoft.AspNetCore.Identity.UserManager<AiExamProctoring.Models.ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var teacher = await UserManager.GetUserAsync(User);
    var pendingInvites = teacher is null ? 0 : await TeacherDb.ExamInvigilators.CountAsync(i => i.TeacherId == teacher.Id && !i.IsActive && i.AcceptedAtUtc == null && i.RevokedAtUtc == null);
    var displayName = teacher?.FullName ?? User.Identity?.Name ?? "Teacher";
    var profileImage = string.IsNullOrWhiteSpace(teacher?.ProfileImage)
      ? Url.Content("~/images/default-user.svg")
      : Url.Content(teacher.ProfileImage);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4f46e5" />
    <title>@ViewData["Title"] - AI Based Online Examination System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/exam-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teacher-workspace.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/device-layout.css" asp-append-version="true" />
</head>
<body class="admin-body teacher-body">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="admin-shell">
        <header class="admin-topbar teacher-topbar">
            <div class="container-fluid d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#teacherSidebar" aria-label="Open navigation"><i class="bi bi-list fs-4"></i></button>
                    <a class="brand" aria-label="Teacher dashboard" asp-area="Teacher" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-journal-check"></i></span><span><strong>AI Based Online Examination System</strong><small>Teacher Portal</small></span></a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-light btn-sm d-none d-md-inline-flex align-items-center gap-2" asp-area="Teacher" asp-controller="Exam" asp-action="Create"><i class="bi bi-plus-circle"></i>Create Exam</a>
                    <a class="btn btn-light btn-sm d-none d-sm-inline-flex" asp-area="Teacher" asp-controller="Classes" asp-action="Index">Classes</a>
                    <a class="btn btn-light btn-sm" asp-area="Teacher" asp-controller="Invitations" asp-action="Index" id="invitationBadge" aria-live="polite">Invites (@pendingInvites)</a>
                    <div class="dropdown">
                        <button class="btn user-menu dropdown-toggle" data-bs-toggle="dropdown">
                            <img src="@profileImage" class="avatar object-fit-cover" alt="Teacher profile" onerror="this.onerror=null;this.src='@Url.Content("~/images/default-user.svg")';" />
                            <span class="d-none d-sm-inline text-start"><strong>@displayName</strong><small>Approved Teacher</small></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2"><li><a class="dropdown-item rounded-3" asp-area="Teacher" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>My Profile</a></li><li><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button class="dropdown-item rounded-3 text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></form></li></ul>
                    </div>
                </div>
            </div>
        </header>
        <div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="teacherSidebar"><div class="offcanvas-header border-bottom"><strong>Teacher Navigation</strong><button class="btn-close" type="button" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body p-0">@await Html.PartialAsync("~/Areas/Teacher/Views/Shared/_TeacherSidebar.cshtml", controller)</div></div>
        <aside class="admin-sidebar teacher-sidebar d-none d-lg-block">@await Html.PartialAsync("~/Areas/Teacher/Views/Shared/_TeacherSidebar.cshtml", controller)</aside>
        <main id="main-content" tabindex="-1" class="admin-main">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show modern-alert"><i class="bi bi-check-circle-fill me-2"></i>@success<button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show modern-alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@error<button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/teacher-invitations.js" asp-append-version="true"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/teacher-collaboration.js" asp-append-version="true"></script>
</body>
</html>
