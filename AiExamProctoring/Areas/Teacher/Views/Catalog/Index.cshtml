@model AiExamProctoring.ViewModels.TeacherCatalogViewModel
@{
    ViewData["Title"] = "Manage Question Subjects";
}
<div class="qb-page qb-catalog-page">
    <header class="qb-hero">
        <div><span class="qb-overline"><i class="bi bi-folder2-open me-1" aria-hidden="true"></i>Question organization</span><h1>Subject Catalog</h1><p>Browse available subjects and organize questions. Shared and protected subjects cannot be renamed or archived by individual teachers.</p></div>
        <div class="qb-hero-actions"><a asp-area="Teacher" asp-controller="Question" asp-action="Index" class="btn qb-hero-primary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Question Bank</a></div>
    </header>

    <div class="qb-metrics qb-catalog-metrics" aria-label="Catalog summary">
        <div class="qb-metric"><span class="qb-metric-icon qb-ic-blue"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></span><span><strong>@Model.ActiveSubjectCount</strong><small>Active subjects shown</small></span></div>
        <div class="qb-metric"><span class="qb-metric-icon qb-ic-teal"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><span><strong>@Model.VisibleQuestionCount</strong><small>Accessible active MCQs</small></span></div>
        <div class="qb-metric"><span class="qb-metric-icon qb-ic-violet"><i class="bi bi-shield-lock" aria-hidden="true"></i></span><span><strong>@Model.LockedSubjectCount</strong><small>Protected subjects shown</small></span></div>
    </div>

    <section class="qb-panel qb-catalog-create" id="subjects" aria-labelledby="qb-add-subject-title">
        <div class="qb-panel-head"><div><span class="qb-mini-heading">Organize</span><h2 id="qb-add-subject-title">Add a subject</h2></div></div>
        <form asp-area="Teacher" asp-controller="Catalog" asp-action="CreateSubject" method="post" data-prevent-double-submit>
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-lg-4"><label for="qbSubjectName" class="form-label">Subject name</label><input id="qbSubjectName" name="subjectName" class="form-control" maxlength="150" minlength="2" required placeholder="e.g. Computer Science"/></div>
                <div class="col-lg-6"><label for="qbSubjectDescription" class="form-label">Description <span class="qb-optional">Optional</span></label><input id="qbSubjectDescription" name="description" class="form-control" maxlength="500" placeholder="Topics covered by this subject"/></div>
                <div class="col-lg-2 d-grid"><button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add subject</button></div>
            </div>
        </form>
    </section>

    <section class="qb-panel qb-catalog-list" aria-labelledby="qb-catalog-title">
        <div class="qb-panel-head"><div><span class="qb-mini-heading">Directory</span><h2 id="qb-catalog-title">Available subjects</h2><p class="qb-description">Select a subject to view its questions. Shared and locked subjects stay read-only.</p></div></div>
        <form asp-area="Teacher" asp-controller="Catalog" asp-action="Index" method="get" class="qb-catalog-filters">
            <div class="qb-search-field"><i class="bi bi-search" aria-hidden="true"></i><label class="visually-hidden" for="qbSubjectSearch">Search subjects</label><input type="search" id="qbSubjectSearch" name="search" maxlength="120" value="@Model.Search" placeholder="Search a subject" /></div>
            <label class="visually-hidden" for="qbCatalogStatus">Subject status</label>
            <select id="qbCatalogStatus" name="status" class="form-select"><option value="all" selected="@(Model.Status == "all")">All statuses</option><option value="active" selected="@(Model.Status == "active")">Active only</option><option value="archived" selected="@(Model.Status == "archived")">Archived only</option></select>
            <button type="submit" class="btn btn-primary">Filter</button>
            @if(Model.Search is not null || Model.Status != "all") { <a asp-area="Teacher" asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Reset</a> }
        </form>
        @if (Model.Subjects.Count == 0)
        {
            <div class="qb-empty"><i class="bi bi-folder2-open" aria-hidden="true"></i><h3>No matching subjects</h3><p>Adjust your search or create a new subject using the form above.</p></div>
        }
        else
        {
            <div class="qb-catalog-grid">
                @foreach (var subject in Model.Subjects)
                {
                    <article class="qb-catalog-item">
                        <div class="qb-catalog-item-head"><span class="qb-subject-tile"><i class="bi bi-folder" aria-hidden="true"></i></span><div class="qb-tags"><span class="qb-tag @(subject.IsActive ? "qb-tag-active" : "qb-tag-archived")">@(subject.IsActive ? "Active" : "Archived")</span>@if(subject.IsLocked){<span class="qb-tag qb-tag-neutral"><i class="bi bi-lock-fill" aria-hidden="true"></i> Shared / protected</span>}</div></div>
                        <h3>@subject.SubjectName</h3>
                        <p>@(string.IsNullOrWhiteSpace(subject.Description) ? "Browse and organize MCQs in this subject." : subject.Description)</p>
                        <div class="qb-catalog-counts"><span><strong>@subject.VisibleActiveQuestionCount</strong> accessible active MCQs</span><span>@subject.MyQuestionCount mine · @subject.SharedQuestionCount verified</span></div>
                        <div class="qb-catalog-actions">
                            <a asp-area="Teacher" asp-controller="Question" asp-action="Index" asp-route-subjectId="@subject.SubjectId" class="btn qb-card-btn"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Browse MCQs</a>
                            @if (!subject.IsLocked)
                            {
                                <details class="qb-catalog-editor">
                                    <summary class="btn qb-card-btn"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Manage</summary>
                                    <div class="qb-catalog-editor-body">
                                        <form asp-area="Teacher" asp-controller="Catalog" asp-action="UpdateSubject" method="post" data-prevent-double-submit>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="subjectId" value="@subject.SubjectId" />
                                            <label class="form-label" for="subject-name-@subject.SubjectId">Subject name</label><input class="form-control mb-2" id="subject-name-@subject.SubjectId" name="subjectName" required maxlength="150" minlength="2" value="@subject.SubjectName" />
                                            <label class="form-label" for="subject-description-@subject.SubjectId">Description</label><textarea class="form-control mb-2" id="subject-description-@subject.SubjectId" name="description" rows="2" maxlength="500">@subject.Description</textarea>
                                            <button type="submit" class="btn btn-primary btn-sm w-100">Save subject</button>
                                        </form>
                                        <form asp-area="Teacher" asp-controller="Catalog" asp-action="ToggleSubject" method="post" class="mt-2">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@subject.SubjectId" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">@(subject.IsActive ? "Archive subject" : "Reactivate subject")</button>
                                        </form>
                                    </div>
                                </details>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
