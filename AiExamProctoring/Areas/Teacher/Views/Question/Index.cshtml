@model AiExamProctoring.ViewModels.TeacherQuestionBankViewModel
@{
    ViewData["Title"] = "Teacher Question Bank";
}

<section class="dashboard-hero teacher-hero mb-4">
    <div class="dashboard-hero-content">
        <div><span class="eyebrow text-white-50">Teacher question bank</span><h1 class="h2 fw-bold text-white mb-2">Question Bank</h1><p class="text-white-50 mb-0">Browse verified Pakistani-test MCQs, manage your own questions and build examination papers subject by subject.</p></div>
        <div class="d-flex flex-wrap gap-2"><a asp-controller="Catalog" asp-action="Index" asp-fragment="subjects" class="btn btn-outline-light rounded-pill px-4"><i class="bi bi-sliders2 me-1"></i>Manage Subjects</a><a asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-light rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>Add New MCQ</a></div>
    </div>
</section>

<div class="alert alert-success border-0 rounded-4 d-flex align-items-start gap-3 mb-4"><i class="bi bi-check-circle-fill fs-4"></i><div><strong>The Question Bank is now fully available inside the Teacher module.</strong><div class="small mt-1">Verified starter MCQs and your own MCQs appear together. Starter content is protected; use “Make editable copy” when you want to customize it.</div></div></div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="metric-card"><strong>@Model.SharedQuestionCount</strong><span>Verified shared MCQs</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><strong class="text-primary">@Model.MyQuestionCount</strong><span>My MCQs</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><strong>@Model.ActiveSubjectCount</strong><span>Active subjects</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><strong>@Model.TotalMatching</strong><span>Current results</span></div></div>
</div>

<section class="dashboard-card mb-4">
    <div class="dashboard-card-header"><div><span class="eyebrow">Subjects</span><h2 class="h5 fw-bold mb-0 mt-1">Choose a subject</h2></div><a asp-controller="Catalog" asp-action="Index" asp-fragment="subjects" class="btn btn-sm btn-light border rounded-pill">Add / manage subjects</a></div>
    <div class="dashboard-card-body">
        <div class="subject-folder-grid teacher-bank-folders">
            <a asp-action="Index" asp-route-source="@Model.Source" class="subject-folder @(!Model.SubjectId.HasValue ? "active" : null)"><span class="subject-folder-icon"><i class="bi bi-collection-fill"></i></span><span class="subject-folder-copy"><strong>All subjects</strong><small>@(Model.SharedQuestionCount + Model.MyQuestionCount) available</small></span><i class="bi bi-chevron-right"></i></a>
            @foreach (var subject in Model.Subjects)
            {
                <a asp-action="Index" asp-route-subjectId="@subject.SubjectId" asp-route-source="@Model.Source" class="subject-folder @(Model.SubjectId == subject.SubjectId ? "active" : null)" title="@subject.Description"><span class="subject-folder-icon"><i class="bi bi-folder2-open"></i></span><span class="subject-folder-copy"><strong>@subject.SubjectName</strong><small>@subject.SharedQuestionCount shared · @subject.MyQuestionCount mine</small></span><i class="bi bi-chevron-right"></i></a>
            }
        </div>
    </div>
</section>

<form method="get" class="dashboard-card mb-4" data-question-filter>
    <div class="dashboard-card-body">
        <input type="hidden" name="subjectId" value="@Model.SubjectId" />
        <div class="row g-3 align-items-end">
            <div class="col-lg-4"><label class="form-label fw-semibold">Search question, topic or tag</label><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input name="search" value="@Model.Search" class="form-control" placeholder="e.g. gravity, Pakistan, algebra" /></div></div>
            <div class="col-lg-3"><label class="form-label fw-semibold">Question source</label><select name="source" class="form-select"><option value="all" selected="@(Model.Source == "all" ? "selected" : null)">All available questions</option><option value="shared" selected="@(Model.Source == "shared" ? "selected" : null)">Verified starter/shared</option><option value="mine" selected="@(Model.Source == "mine" ? "selected" : null)">My editable questions</option></select></div>
            <div class="col-lg-3"><label class="form-label fw-semibold">Status</label><select name="active" class="form-select"><option value="">Any status</option><option value="true" selected="@(Model.Active is true ? "selected" : null)">Active</option><option value="false" selected="@(Model.Active is false ? "selected" : null)">Archived</option></select></div>
            <div class="col-lg-2 d-grid"><button class="btn btn-primary" type="submit">Apply Filters</button></div>
        </div>
    </div>
</form>

<section class="dashboard-card">
    <div class="dashboard-card-header"><div><span class="eyebrow">@Model.SelectedSubjectName.ToUpperInvariant()</span><h2 class="h5 fw-bold mb-0 mt-1">@Model.TotalMatching MCQs found</h2></div><a asp-controller="Exam" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-file-earmark-plus me-1"></i>Open exam paper builder</a></div>
    <div class="table-responsive">
        <table class="table align-middle table-modern mb-0">
            <thead><tr><th>Subject / Source</th><th>Question and options</th><th>Correct answer</th><th>Status</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Questions)
            {
                var q = row.Question;
                <tr>
                    <td><strong>@q.Subject?.SubjectName</strong><div class="small text-secondary">@(q.Topic ?? "General")</div><span class="badge-soft @(row.IsMine ? "soft-primary" : "soft-success") mt-2 d-inline-block">@row.SourceLabel</span></td>
                    <td style="min-width:380px"><strong>@q.QuestionText</strong><div class="small text-secondary mt-2"><span class="d-block">A. @q.OptionA</span><span class="d-block">B. @q.OptionB</span><span class="d-block">C. @q.OptionC</span><span class="d-block">D. @q.OptionD</span>@if(!string.IsNullOrWhiteSpace(q.OptionE)){<span class="d-block">E. @q.OptionE</span>}</div></td>
                    <td><span class="badge text-bg-success fs-6">@q.CorrectAnswer</span><div class="small text-secondary mt-2">@q.CorrectAnswerText</div></td>
                    <td><span class="badge @(q.IsActive ? "text-bg-success" : "text-bg-secondary")">@(q.IsActive ? "Active" : "Archived")</span>@if(q.IsLocked){<div class="small text-danger mt-2"><i class="bi bi-lock-fill"></i> Locked paper</div>}</td>
                    <td class="text-end text-nowrap">
                        @if (row.IsMine)
                        {
                            <a asp-action="Edit" asp-route-id="@q.QuestionId" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-pencil me-1"></i>Edit</a>
                            <form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@q.QuestionId"/><button class="btn btn-sm btn-light border rounded-pill" type="submit">@(q.IsActive ? "Archive" : "Enable")</button></form>
                        }
                        else
                        {
                            <form asp-action="CopyToMine" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@q.QuestionId"/><button class="btn btn-sm btn-outline-dark rounded-pill" type="submit"><i class="bi bi-copy me-1"></i>Make editable copy</button></form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Questions.Count == 0)
            {
                <tr><td colspan="5"><div class="empty-state py-5"><i class="bi bi-folder2-open"></i><h3 class="h5 fw-bold mt-3">No MCQ matches these filters</h3><p class="text-secondary">Clear filters, open another subject, or add your own question.</p><a asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-primary rounded-pill px-4">Add first MCQ</a></div></td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Question pages"><ul class="pagination justify-content-center"><li class="page-item @(Model.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-subjectId="@Model.SubjectId" asp-route-search="@Model.Search" asp-route-source="@Model.Source" asp-route-active="@Model.Active">Previous</a></li>@for(var i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":null)"><a class="page-link" asp-route-page="@i" asp-route-subjectId="@Model.SubjectId" asp-route-search="@Model.Search" asp-route-source="@Model.Source" asp-route-active="@Model.Active">@i</a></li>}<li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-subjectId="@Model.SubjectId" asp-route-search="@Model.Search" asp-route-source="@Model.Source" asp-route-active="@Model.Active">Next</a></li></ul></nav>
}

@section Styles {
<style>
    .teacher-bank-folders{max-height:360px;overflow:auto;padding:2px}.teacher-bank-folders .subject-folder{min-height:82px}
    @@media(max-width:767.98px){.teacher-bank-folders{max-height:none}}
</style>
}
