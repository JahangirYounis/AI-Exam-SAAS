@model AiExamProctoring.Models.Question
@{ViewData["Title"]="Add MCQ"; int? examId = ViewBag.ExamId as int?;}
@if (examId.HasValue)
{
    <div class="alert alert-info">New question for <strong>@ViewBag.ExamTitle</strong>. Saving adds it to this exam and your private question bank. Subject and topic are optional.</div>
    <a asp-controller="ExamQuestion" asp-action="Index" asp-route-examId="@examId" class="btn btn-outline-primary mb-3">Back to exam questions</a>
}
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><span class="eyebrow">Question bank</span><h1 class="h2 fw-bold mb-1">Add a New MCQ</h1><p class="text-secondary mb-0">Complete the question, options and correct answer. You can reuse it in any examination.</p></div><a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-light border rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i>Back to Question Bank</a></div>
<div class="row justify-content-center"><div class="col-xl-9"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5"><div class="alert alert-info border-0 rounded-4"><i class="bi bi-info-circle me-2"></i><b>No marks are set here.</b> Marks are distributed automatically when this MCQ is selected for an examination.</div><form method="post" data-prevent-double-submit>@Html.AntiForgeryToken()<input type="hidden" name="examId" value="@examId"/><input type="hidden" asp-for="QuestionId"/><input type="hidden" asp-for="IsActive" value="true"/><div asp-validation-summary="All" class="alert alert-danger rounded-4"></div><div class="row g-3">
<div class="col-md-6"><label asp-for="SubjectId" class="form-label fw-semibold">Subject (optional)</label><select asp-for="SubjectId" asp-items="ViewBag.Subjects" class="form-select"><option value="0">No subject — organize later</option></select><div class="form-text">Without a subject, this question goes into Uncategorized.</div></div><div class="col-md-6"><label asp-for="Topic" class="form-label">Topic (optional)</label><input asp-for="Topic" class="form-control"/></div>
<div class="col-12"><label asp-for="QuestionText" class="form-label fw-semibold"></label><textarea asp-for="QuestionText" class="form-control" rows="4"></textarea></div>
<div class="col-md-6"><label asp-for="OptionA" class="form-label">Option A</label><input asp-for="OptionA" class="form-control"/></div><div class="col-md-6"><label asp-for="OptionB" class="form-label">Option B</label><input asp-for="OptionB" class="form-control"/></div><div class="col-md-6"><label asp-for="OptionC" class="form-label">Option C</label><input asp-for="OptionC" class="form-control"/></div><div class="col-md-6"><label asp-for="OptionD" class="form-label">Option D</label><input asp-for="OptionD" class="form-control"/></div><div class="col-md-6"><label asp-for="OptionE" class="form-label">Option E (optional)</label><input asp-for="OptionE" class="form-control"/></div><div class="col-md-6"><label asp-for="CorrectAnswer" class="form-label">Correct answer</label><select asp-for="CorrectAnswer" class="form-select"><option>A</option><option>B</option><option>C</option><option>D</option><option>E</option></select></div>
<div class="col-md-8"><label asp-for="Tags" class="form-label"></label><input asp-for="Tags" class="form-control"/></div><div class="col-md-4"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control" type="number"/></div>
<div class="col-md-6"><label asp-for="ImagePath" class="form-label"></label><input asp-for="ImagePath" class="form-control"/></div><div class="col-md-6"><label asp-for="Explanation" class="form-label"></label><input asp-for="Explanation" class="form-control"/></div>
</div><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-light border rounded-pill px-4">Cancel</a><button class="btn btn-primary rounded-pill px-5" type="submit"><i class="bi bi-check2-circle me-1"></i>@(examId.HasValue ? "Save and add to exam" : "Save MCQ")</button></div></form></div></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
