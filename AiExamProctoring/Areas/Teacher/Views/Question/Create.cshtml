@model AiExamProctoring.Models.Question
@{
    ViewData["Title"] = "Add MCQ";
    ViewData["QuestionFormMode"] = "create";
    int? examId = ViewBag.ExamId as int?;
}
<div class="qb-page qb-editor-page">
    <nav aria-label="Breadcrumb" class="qb-breadcrumb"><a asp-area="Teacher" asp-controller="Question" asp-action="Index">Question Bank</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Add MCQ</span></nav>
    <header class="qb-editor-header"><span class="qb-mini-heading">Question editor</span><h1>Add a new MCQ</h1><p>Build a reusable multiple-choice question. You can attach it to an examination or save it for later.</p></header>
    @if (examId.HasValue)
    {
        <div class="qb-context-notice"><i class="bi bi-journal-check" aria-hidden="true"></i><div><strong>Adding to @ViewBag.ExamTitle</strong><span>Saving this MCQ will also add it to the selected draft examination.</span></div></div>
    }
    <partial name="_QuestionForm" model="Model" />
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
