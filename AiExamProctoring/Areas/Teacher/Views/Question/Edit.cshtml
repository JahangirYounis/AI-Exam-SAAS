@model AiExamProctoring.Models.Question
@{
    ViewData["Title"] = "Edit MCQ";
    ViewData["QuestionFormMode"] = "edit";
}
<div class="qb-page qb-editor-page">
    <nav aria-label="Breadcrumb" class="qb-breadcrumb"><a asp-area="Teacher" asp-controller="Question" asp-action="Index" asp-route-source="mine">My Questions</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Edit MCQ</span></nav>
    <header class="qb-editor-header"><span class="qb-mini-heading">Question editor</span><h1>Edit MCQ</h1><p>Update your own MCQ. Questions already locked in published examination papers cannot be changed.</p></header>
    <partial name="_QuestionForm" model="Model" />
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
