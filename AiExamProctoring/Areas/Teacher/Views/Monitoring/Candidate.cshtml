@model AiExamProctoring.ViewModels.ProctoringCandidateFolderPageViewModel
@{ViewData["Title"]="Candidate Evidence";var c=Model.Candidate;var imageUrl=string.IsNullOrWhiteSpace(c.ProfileImage)?Url.Content("~/images/default-user.svg"):Url.Content(c.ProfileImage);}
<nav class="small mb-3"><a asp-action="Index">Candidate folders</a><span class="mx-2 text-secondary">/</span><span>@c.CandidateName</span></nav>
<div class="proctor-candidate-hero mb-4"><img src="@imageUrl" alt="@c.CandidateName"/><div class="min-w-0 flex-grow-1"><span class="eyebrow">Candidate folder</span><h2 class="fw-bold mb-1">@c.CandidateName</h2><p class="mb-0 text-secondary">@c.CandidateNumber · @c.Email</p></div><div class="d-flex flex-wrap gap-2"><span class="badge-soft soft-primary">@c.ExamFolderCount exams</span><span class="badge-soft soft-warning">@c.PendingCount pending</span><span class="badge-soft soft-danger">@c.HighSeverityCount high</span></div></div>
<div class="row g-4">@foreach(var f in Model.ExamFolders){<div class="col-md-6 col-xl-4"><a asp-action="ExamFolder" asp-route-studentId="@c.StudentId" asp-route-examId="@f.ExamId" class="proctor-folder-card h-100"><div class="d-flex gap-3 align-items-start"><div class="exam-folder-icon"><i class="bi bi-folder2-open"></i></div><div class="min-w-0 flex-grow-1"><strong class="d-block text-truncate">@f.ExamTitle</strong><small class="text-secondary">@f.Audience · @f.Purpose</small></div><i class="bi bi-chevron-right text-secondary"></i></div><div class="proctor-folder-metrics"><span><strong>@f.AttemptCount</strong> attempts</span><span><strong>@f.AlertCount</strong> events</span><span><strong>@f.EvidenceCount</strong> files</span></div><div class="d-flex justify-content-between align-items-center mt-3"><span class="badge-soft @(f.PendingCount>0?"soft-warning":"soft-success")">@f.PendingCount pending</span><small class="text-secondary">@(f.LatestEventAt?.ToString("dd MMM, hh:mm tt")??"—")</small></div></a></div>}</div>
