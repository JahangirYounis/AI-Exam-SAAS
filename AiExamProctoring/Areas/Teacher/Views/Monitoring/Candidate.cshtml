@model AiExamProctoring.ViewModels.TeacherEvidenceCandidateViewModel
@{
    ViewData["Title"] = "Candidate evidence · " + Model.StudentName;
}
<div class="teacher-evidence">
    <nav class="te-breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">Examination evidence</a><i class="bi bi-chevron-right"></i><a asp-action="Exam" asp-route-examId="@Model.ExamId">@Model.ExamTitle</a><i class="bi bi-chevron-right"></i><span>@Model.StudentName</span></nav>
    <header class="te-page-heading"><div><span class="te-eyebrow">Student attempt folders</span><h1>@Model.StudentName</h1><p>@(Model.CandidateNumber ?? "Candidate number unavailable") · @Model.ExamTitle</p></div><span class="te-chip">@Model.Attempts.Count attempt(s)</span></header>
    <section class="te-panel">
        <div class="te-panel-heading"><div><h2>Examination attempts</h2><p>Each attempt contains its own incidents, evidence and review state.</p></div></div>
        @foreach (var a in Model.Attempts)
        {
            <a class="te-attempt-row" asp-action="ExamFolder" asp-route-studentId="@Model.StudentId" asp-route-examId="@Model.ExamId" asp-route-attemptId="@a.AttemptId">
                <span class="te-folder-icon"><i class="bi bi-folder2-open"></i></span>
                <div class="te-attempt-main"><strong>Attempt #@a.AttemptId</strong><small>Started @a.StartedAt.ToString("dd MMM yyyy, hh:mm tt") · @(a.CompletedAt.HasValue ? "Finished " + a.CompletedAt.Value.ToString("dd MMM, hh:mm tt") : "Not yet completed")</small></div>
                <div class="te-attempt-metrics"><span class="te-chip @(a.Status == AiExamProctoring.Models.AttemptStatus.ProctoringBlocked ? "te-chip-danger" : "")">@a.Status</span><span>@a.PendingEvents pending</span><span>@a.EvidenceFiles files</span></div><i class="bi bi-chevron-right"></i>
            </a>
        }
        @if (Model.Attempts.Count == 0)
        {
            <div class="te-empty"><h3>No attempts</h3><p>No valid Student-role exam attempts are available.</p></div>
        }
    </section>
</div>
