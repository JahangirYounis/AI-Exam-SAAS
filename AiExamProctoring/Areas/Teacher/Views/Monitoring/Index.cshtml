@model AiExamProctoring.ViewModels.TeacherEvidenceIndexViewModel
@{
    ViewData["Title"] = "Exam evidence review";
}
<div class="teacher-evidence">
    <header class="te-header">
        <div>
            <span class="te-eyebrow"><i class="bi bi-shield-lock me-1"></i> Secure teacher review</span>
            <h1>Examination evidence</h1>
            <p>Open a test first, then review its flagged students and individual attempts.</p>
        </div>
        <a asp-action="Live" class="btn btn-light te-top-action"><i class="bi bi-camera-video me-2"></i>Live monitoring</a>
    </header>

    <section class="te-stat-grid" aria-label="Evidence overview">
        <div class="te-stat"><i class="bi bi-folder2-open" aria-hidden="true"></i><strong>@Model.TotalExams</strong><span>Accessible exams</span></div>
        <div class="te-stat"><i class="bi bi-people" aria-hidden="true"></i><strong>@Model.TotalCandidates</strong><span>Students in listed tests</span></div>
        <div class="te-stat"><i class="bi bi-shield-exclamation" aria-hidden="true"></i><strong>@Model.BlockedStudents</strong><span>Blocked students</span></div>
        <div class="te-stat"><i class="bi bi-hourglass-split" aria-hidden="true"></i><strong>@Model.PendingStudents</strong><span>Students with pending reviews</span></div>
    </section>

    <section class="te-panel">
        <div class="te-panel-heading">
            <div><h2>Test evidence folders</h2><p>Only examinations you own or are authorized to monitor.</p></div>
            <form method="get" asp-action="Index" class="te-search" role="search">
                <label class="visually-hidden" for="te-exam-search">Search your examinations</label>
                <input id="te-exam-search" class="form-control" type="search" name="search" value="@Model.Search" maxlength="120" placeholder="Search examination name" />
                <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Search</button>
            </form>
        </div>
        @if (Model.Exams.Count == 0)
        {
            <div class="te-empty"><i class="bi bi-folder-x" aria-hidden="true"></i><h3>No examinations found</h3><p>Try another search or return to My Examinations. Evidence appears under the exam that generated it.</p><a asp-controller="Exam" asp-action="Index" class="btn btn-outline-primary">My Examinations</a></div>
        }
        else
        {
            <div class="te-exam-grid">
                @foreach (var exam in Model.Exams)
                {
                    <a asp-action="Exam" asp-route-examId="@exam.ExamId" class="te-exam-card">
                        <div class="te-card-top"><span class="te-folder-icon"><i class="bi bi-folder2-open"></i></span><span class="te-chip">@(exam.IsOwner ? "My exam" : "Shared · Monitor access")</span></div>
                        <h3>@exam.Title</h3>
                        <div class="te-subline">#@exam.ExamId · @(exam.IsReusable ? "Reusable practice" : exam.ExamDate.ToString("dd MMM yyyy")) · @exam.Status</div>
                        <div class="te-card-metrics"><span><strong>@exam.StudentsTested</strong> tested</span><span><strong>@exam.BlockedStudents</strong> blocked</span><span><strong>@exam.FlaggedStudents</strong> flagged</span><span><strong>@exam.PendingStudents</strong> pending</span></div>
                        <div class="te-card-footer"><span>@exam.TotalAttempts recorded attempt(s)</span><span>Open folder <i class="bi bi-chevron-right"></i></span></div>
                    </a>
                }
            </div>
        }
    </section>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Examination evidence pages" class="te-pagination">
            <a class="btn btn-outline-secondary @(Model.Page == 1 ? "disabled" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)" aria-disabled="@(Model.Page==1)">Previous</a>
            <span>Page @Model.Page of @Model.TotalPages</span>
            <a class="btn btn-outline-secondary @(Model.Page == Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)" aria-disabled="@(Model.Page==Model.TotalPages)">Next</a>
        </nav>
    }
    <p class="te-footnote">Counts reflect real Student-role examination attempts. System audit entries and unrelated accounts cannot create candidate folders.</p>
</div>
