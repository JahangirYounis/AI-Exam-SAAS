@{
    ViewData["Title"] = "Live examination room";
    var exams = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Exams;
}
<a class="btn btn-outline-primary mb-3" asp-controller="Invitations" asp-action="Index">Teacher invitations and team discussions</a>
<div id="live-room" data-exam="@ViewBag.ExamId">
    <div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
        <div><h2>Live examination room</h2><p>Watch candidates, review alerts, and pause an attempt when you need to intervene.</p></div>
        <a asp-action="Index" class="btn btn-outline-primary align-self-start">Saved recordings &amp; review</a>
    </div>
    <form method="get" class="d-flex gap-2 mb-3">
        <label for="live-exam" class="align-self-center">Exam</label>
        <select id="live-exam" name="examId" class="form-select" style="max-width:480px">
            @foreach (var exam in exams) { <option value="@exam.Value" selected="@(exam.Value == ViewBag.ExamId.ToString())">@exam.Text</option> }
        </select><button class="btn btn-primary">Open live room</button>
    </form>
    @Html.AntiForgeryToken()
    <p class="small text-secondary">Live camera views · Green = normal · Blinking red = active violation · Click a video to enlarge it. Videos are muted. Desktop screens are not shared.</p>
    <a class="btn btn-outline-primary mb-3" asp-controller="ExamQuestion" asp-action="Index" asp-route-examId="@ViewBag.ExamId">View / build question paper</a>
    <p id="room-status" role="status">Connecting…</p>
    <div id="camera-grid" class="camera-grid"></div>
    <div class="d-flex gap-3 align-items-center my-3"><button id="live-prev" class="btn btn-outline-primary">Previous</button><span id="live-page"></span><button id="live-next" class="btn btn-outline-primary">Next</button></div>
</div>
<dialog id="pause-dialog" class="rounded-3 p-4 border-0" style="max-width:480px;width:95%">
    <form id="pause-form"><h3>Pause this attempt?</h3><p id="pause-name"></p><label for="pause-reason">What did you review?</label><textarea id="pause-reason" class="form-control my-2" minlength="10" maxlength="300" required></textarea><p class="small">The candidate's saved answers are kept. You can review and authorize resume in their evidence folder.</p><p id="pause-error" role="alert"></p><button class="btn btn-danger">Pause attempt</button><button type="button" id="pause-cancel" class="btn btn-outline-secondary">Cancel</button></form>
</dialog>
<style>
.camera-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:16px}.camera-tile{border:3px solid #15803d;border-radius:14px;overflow:hidden;background:white}.camera-tile.needs-review{border-color:#dc2626;animation:violation-pulse 1s infinite;order:-1}.camera-tile video{display:block;width:100%;aspect-ratio:4/3;background:#132332;object-fit:contain;cursor:zoom-in}.camera-tile .tile-info{padding:12px}.camera-tile .tile-alert{color:#166534;font-weight:700}.camera-tile button,.camera-tile a{margin:4px 5px 0 0}dialog::backdrop{background:#14253699}
@@keyframes violation-pulse{50%{box-shadow:0 0 0 4px #dc262666}}
@@media(prefers-reduced-motion:reduce){.camera-tile.needs-review{animation:none}}
</style>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/proctoring-client.js" asp-append-version="true"></script>
    <script src="~/js/live-proctoring.js" asp-append-version="true"></script>
    <script src="~/js/teacher-live-room.js" asp-append-version="true"></script>
}
