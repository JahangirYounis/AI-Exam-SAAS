@model AiExamProctoring.ViewModels.TeacherDirectoryViewModel
@{
    ViewData["Title"] = "Teacher connections";
}
<div class="teacher-community">
    <header class="tcom-hero">
        <div><span class="tcom-eyebrow"><i class="bi bi-people"></i> Teacher network</span>
            <h1>Connect with colleagues</h1><p>Find approved teachers, manage invitations and open private conversations.</p></div>
        <a asp-controller="Community" asp-action="Index" class="btn btn-light"><i class="bi bi-grid me-1"></i> Community feed</a>
    </header>
    <nav class="tcom-tabs" aria-label="Teacher connection categories">
        <a asp-action="Index" asp-route-tab="directory" class="@(Model.Tab == "directory" ? "active" : "")">Directory</a>
        <a asp-action="Index" asp-route-tab="received" class="@(Model.Tab == "received" ? "active" : "")">Received <span>@Model.ReceivedCount</span></a>
        <a asp-action="Index" asp-route-tab="sent" class="@(Model.Tab == "sent" ? "active" : "")">Sent <span>@Model.SentCount</span></a>
        <a asp-action="Index" asp-route-tab="connected" class="@(Model.Tab == "connected" ? "active" : "")">My connections <span>@Model.ConnectedCount</span></a>
    </nav>
    <section class="tcom-panel">
        <form method="get" asp-action="Index" class="tcom-search">
            <input type="hidden" name="tab" value="@Model.Tab" />
            <label class="visually-hidden" for="teacher-search">Search approved teachers</label>
            <input id="teacher-search" type="search" name="search" maxlength="100" value="@Model.Search" placeholder="Search teacher, department or organisation" class="form-control" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i> Search</button>
        </form>
        <div class="tcom-directory">
            @foreach (var item in Model.People)
            {
                var avatar = string.IsNullOrWhiteSpace(item.ProfileImage) ? Url.Content("~/images/default-user.svg") : Url.Content(item.ProfileImage);
                <article class="tcom-person">
                    <img class="tcom-avatar" src="@avatar" alt="" loading="lazy" onerror="this.onerror=null;this.src='@Url.Content("~/images/default-user.svg")'" />
                    <div class="tcom-person-info">
                        <a asp-controller="Community" asp-action="Profile" asp-route-id="@item.Id" class="tcom-person-name">@item.FullName</a>
                        <p>@(item.Department ?? item.OrganizationName ?? "Approved teacher")@(item.City is null ? "" : " · " + item.City)</p>
                    </div>
                    <div class="tcom-actions">
                        @if (item.Status == "none" || item.Status == "removed" || item.Status == "declined")
                        {
                            <form method="post" asp-action="Connect">@Html.AntiForgeryToken()<input type="hidden" name="teacherId" value="@item.Id" />
                                <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-person-plus me-1"></i> Connect</button></form>
                        }
                        else if (item.Status == "connected")
                        {
                            <a asp-action="Chat" asp-route-id="@item.ConnectionId" class="btn btn-primary btn-sm"><i class="bi bi-chat-dots me-1"></i> Message</a>
                            <form method="post" asp-action="Remove">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ConnectionId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Remove this connection">Remove</button></form>
                        }
                        else if (item.Status == "received")
                        {
                            <form method="post" asp-action="Accept">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ConnectionId" />
                                <button type="submit" class="btn btn-primary btn-sm">Accept</button></form>
                            <form method="post" asp-action="Decline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ConnectionId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Decline</button></form>
                        }
                        else
                        {
                            <span class="tcom-status">Request sent</span>
                            <form method="post" asp-action="Withdraw">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.ConnectionId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Withdraw</button></form>
                        }
                    </div>
                </article>
            }
            @if (Model.People.Count == 0)
            {
                <div class="tcom-empty"><i class="bi bi-people"></i><strong>No teachers found</strong><p>Try another search or return to the directory.</p></div>
            }
        </div>
    </section>
</div>
@section Styles { <link rel="stylesheet" href="~/css/teacher-community.css" asp-append-version="true" /> }
