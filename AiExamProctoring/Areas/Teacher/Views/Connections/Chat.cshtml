@model List<AiExamProctoring.Models.TeacherPrivateMessage>
@{
 ViewData["Title"] = "Private teacher chat";
 var chatPage = new AiExamProctoring.Areas.Teacher.Controllers.TeacherChatPage { Kind = "private", RoomId = (int)ViewBag.ConnectionId, Heading = (string)ViewBag.Colleague, ActorId = (string)ViewBag.Actor };
}
<section class="teacher-chat-page">
 <header class="tcom-hero tcom-chat-heading"><div><span class="tcom-eyebrow"><i class="bi bi-chat-dots"></i> Private conversation</span>
   <h1>@chatPage.Heading</h1><p>Direct messages between connected Teachers.</p></div>
   <a asp-action="Index" asp-route-tab="connected" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i> All conversations</a></header>
 <partial name="~/Areas/Teacher/Views/Shared/_TeacherChatPane.cshtml" model="chatPage" />
</section>
@section Styles {<link rel="stylesheet" href="~/css/teacher-chat-v2.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/teacher-community.css" asp-append-version="true" />}
@section Scripts {<script src="~/js/teacher-chat-v2.js" asp-append-version="true"></script>}
