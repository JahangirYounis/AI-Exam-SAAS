@model AiExamProctoring.Models.ExamAttempt
@{
    ViewData["Title"] = "Saved answer review";
    var answerRows = ViewBag.AnswerRows as IEnumerable<AiExamProctoring.ViewModels.Student.ResultAnswerRow>
        ?? Array.Empty<AiExamProctoring.ViewModels.Student.ResultAnswerRow>();
}
<div class="tw14-workspace tw14-review">
    <nav aria-label="Breadcrumb" class="tw14-back"><a asp-action="Index" asp-route-examId="@Model.ExamId"><i class="bi bi-arrow-left" aria-hidden="true"></i> Result review</a></nav>
    <header class="tw14-hero"><div>
        <span class="tw14-eyebrow"><i class="bi bi-journal-text" aria-hidden="true"></i> Saved academic answers</span>
        <h1>@Model.Student?.FullName</h1>
        <p>@Model.Exam?.ExamTitle · Attempt #@Model.AttemptId · @Model.Status</p>
    </div><a asp-controller="Monitoring" asp-action="ExamFolder" asp-route-examId="@Model.ExamId" asp-route-studentId="@Model.StudentId" asp-route-attemptId="@Model.AttemptId" class="tw14-hero-button">View evidence</a></header>
    <section class="tw14-panel"><h2 class="tw14-section-title">Candidate responses</h2>
        <p class="tw14-muted">These are the saved answers available for academic grading. Integrity observations do not deduct academic marks automatically.</p>
        <partial name="~/Areas/Student/Views/Result/_AnswerRows.cshtml" model="answerRows" />
    </section>
</div>
