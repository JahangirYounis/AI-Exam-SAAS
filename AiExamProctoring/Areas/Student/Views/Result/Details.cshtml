@model AiExamProctoring.Models.ExamResult
@using AiExamProctoring.Models
@using AiExamProctoring.Services.Results
@{
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "My Result Details";
    var attempt = Model.Attempt;
    var exam = attempt?.Exam;
    var grade = StudentResultAccess.GradeLabel(Model.Percentage, exam?.PassingPercentage ?? 100m);
    var passed = grade != "Fail";
    var restricted = attempt?.Status == AttemptStatus.ProctoringBlocked || attempt?.IsDisqualified == true;
    var canDownloadCertificate = attempt?.ResultReleasedAtUtc != null && attempt?.CompletedAt != null;
}
@section Styles { <link rel="stylesheet" href="~/css/student-results.css" asp-append-version="true" /> }
<section class="student-results" aria-labelledby="result-details-heading">
    <div class="sr-detail-top">
        <div>
            <a class="sr-back" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> My results</a>
            <h1 id="result-details-heading">@exam?.ExamTitle</h1>
            <p>Exam roll number: @(ViewBag.ExamRollNumber ?? "Not available") · Attempt #@Model.AttemptId</p>
        </div>
        <div class="sr-header-actions">
            <a asp-action="DownloadPdf" asp-route-id="@Model.ResultId" class="sr-outline-button"><i class="bi bi-download" aria-hidden="true"></i> Result PDF</a>
            @if (canDownloadCertificate)
            { <a asp-action="DownloadCertificate" asp-route-id="@Model.ResultId" class="sr-primary-button"><i class="bi bi-award" aria-hidden="true"></i> @(restricted ? "Finalized result statement" : "Certificate / result statement")</a> }
        </div>
    </div>
    <div class="sr-score-hero">
        <div><span class="sr-hero-label">Your academic result</span><div class="sr-score">@Model.TotalMarksObtained.ToString("0.##") <small>/ @Model.TotalMarks.ToString("0.##") marks</small></div>
            <p>@Model.Percentage.ToString("0.##")% · <strong>@(passed ? "Passed" : "Failed")</strong></p></div>
        <span class="sr-grade @(passed ? "sr-grade-positive" : "sr-grade-negative")">@grade</span>
    </div>
    <div class="sr-detail-grid">
        <div class="sr-detail-card"><small>Examination date</small><strong>@(attempt?.StartedAt.ToString("dd MMM yyyy") ?? "—")</strong></div>
        <div class="sr-detail-card"><small>Minimum passing marks</small><strong>@((Model.TotalMarks * (exam?.PassingPercentage ?? 100m) / 100m).ToString("0.##")) / @Model.TotalMarks.ToString("0.##")</strong></div>
        <div class="sr-detail-card"><small>Review status</small><strong>@StudentResultAccess.ReviewStatus(attempt)</strong></div>
        <div class="sr-detail-card"><small>Attempt status</small><strong>@StudentResultAccess.CompletionStatus(attempt)</strong></div>
    </div>
    @if (restricted)
    {
        <div class="sr-notice" role="status"><i class="bi bi-shield-exclamation" aria-hidden="true"></i><div><strong>Academic marks released; integrity restriction remains.</strong>
            <p>These marks reflect answers graded for this attempt. They do not certify that a blocked or disqualified examination was fully completed.</p>
            <a asp-action="Integrity" asp-route-id="@Model.ResultId">View recorded integrity events</a></div></div>
    }
    <div class="sr-detail-grid sr-answer-grid">
        <div class="sr-detail-card"><small>Correct</small><strong>@Model.CorrectAnswers</strong></div>
        <div class="sr-detail-card"><small>Wrong</small><strong>@Model.WrongAnswers</strong></div>
        <div class="sr-detail-card"><small>Skipped</small><strong>@Model.SkippedAnswers</strong></div>
        <div class="sr-detail-card"><small>Attempted</small><strong>@(Model.CorrectAnswers + Model.WrongAnswers)</strong></div>
    </div>
    <div class="sr-action-row"><a asp-action="QuestionReview" asp-route-id="@Model.ResultId" class="sr-primary-button"><i class="bi bi-list-check" aria-hidden="true"></i> Question-by-question review</a>
        <a asp-action="Integrity" asp-route-id="@Model.ResultId" class="sr-outline-button">Integrity history</a></div>
    <partial name="_AnswerRows" model="@(ViewBag.AnswerRows as IEnumerable<AiExamProctoring.ViewModels.Student.ResultAnswerRow> ?? Array.Empty<AiExamProctoring.ViewModels.Student.ResultAnswerRow>())" />
</section>
