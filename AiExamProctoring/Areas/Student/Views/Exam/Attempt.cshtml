@model AiExamProctoring.ViewModels.Student.SessionAttemptViewModel
@using System
@using System.Linq
@inject Microsoft.Extensions.Options.IOptions<AiExamProctoring.Services.BehaviorAnalysis.BehaviorAnalysisOptions> BehaviorOptions
@inject Microsoft.Extensions.Options.IOptions<AiExamProctoring.Services.FaceIdentity.FaceIdentityOptions> FaceOptions
@{
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Examination in progress";
    ViewData["ActiveExam"] = true;
    Context.Response.Headers["Cache-Control"] = "no-store, no-cache, must-revalidate";
    Context.Response.Headers["Pragma"] = "no-cache";
    var questions = Model.Questions ?? new List<AiExamProctoring.Models.Question>();
    var backAllowed = Model.Exam.AllowBackNavigation;
    var initialQuestionId = ViewBag.ResumeQuestionId is int qid ? qid : questions.FirstOrDefault()?.QuestionId ?? 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/exam-attempt-v2.css" asp-append-version="true" />
}
<div class="exam-taking" id="examWorkspace" data-session-id="@Model.SessionAttempt.SessionAttemptId"
     data-attempt-id="@Model.SessionAttempt.AttemptId" data-resume-question="@initialQuestionId"
     data-server-now="@Model.ServerNow.ToUniversalTime().ToString("O")"
     data-expires="@Model.ExpiresAt.ToUniversalTime().ToString("O")"
     data-back-allowed="@backAllowed.ToString().ToLowerInvariant()"
     data-save-url="@Url.Action("SaveAnswer", "Exam", new { area = "Student" })"
     data-position-url="@Url.Action("SavePosition", "Exam", new { area = "Student" })"
     data-review-url="@Url.Action("ToggleReview", "Exam", new { area = "Student" })"
     data-status-url="@Url.Action("ProctoringStatus", "Exam", new { area = "Student", attemptId = Model.SessionAttempt.AttemptId })"
     data-blocked-url="@Url.Action("Blocked", "Exam", new { area = "Student", attemptId = Model.SessionAttempt.AttemptId })">
    <header class="exam-taking-header">
        <div class="exam-taking-heading">
            <span class="exam-taking-overline"><i class="bi bi-shield-check" aria-hidden="true"></i> PROCTORED EXAMINATION · SESSION @Model.SessionIndex / @Model.TotalSessions</span>
            <h1>@Model.Exam.ExamTitle</h1>
            <p>@Model.Session.SessionTitle · @questions.Count questions · @Model.Session.DurationMinutes minutes</p>
        </div>
        <div class="exam-taking-timer" role="status" aria-live="off">
            <small>Time remaining</small>
            <strong id="examTimeRemaining">--:--</strong>
            <span id="examTimerStatus">Server-based timer</span>
        </div>
    </header>
    <div class="exam-taking-layout">
        <section class="exam-taking-paper" aria-labelledby="examQuestionHeading">
            <div class="exam-taking-progress">
                <div><strong id="examQuestionHeading">Question <span id="examQuestionNumber">1</span> of @questions.Count</strong><span id="examAnsweredCount">0 answered</span></div>
                <div class="exam-progress-track" role="progressbar" aria-label="Questions answered" aria-valuemin="0" aria-valuemax="@questions.Count" aria-valuenow="0" id="examAnswerProgress"><span id="examProgressFill"></span></div>
            </div>
            <div id="examIncidentNotice" role="status" aria-live="polite" hidden></div>
            <div id="examMediaProblem" role="status" hidden></div>
            <form id="examForm" method="post" asp-area="Student" asp-controller="Exam" asp-action="SubmitSession"
                  target="_top"
                  data-attempt="@Model.SessionAttempt.AttemptId" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="sessionAttemptId" value="@Model.SessionAttempt.SessionAttemptId" />
                @for (var index = 0; index < questions.Count; index++)
                {
                    var question = questions[index];
                    var saved = Model.ExistingAnswers.TryGetValue(question.QuestionId, out var option) ? option : null;
                    var marked = Model.ReviewedQuestionIds.Contains(question.QuestionId);
                    var imagePath = question.ImagePath;
                    var localImage = !string.IsNullOrWhiteSpace(imagePath) &&
                        (imagePath.StartsWith("~/", StringComparison.Ordinal) || (imagePath.StartsWith("/", StringComparison.Ordinal) && !imagePath.StartsWith("//", StringComparison.Ordinal)));
                    <section class="question-card exam-question" data-question-id="@question.QuestionId" data-index="@index"
                             data-reviewed="@marked.ToString().ToLowerInvariant()" hidden="@(question.QuestionId != initialQuestionId)" aria-label="Question @(index + 1)">
                        <span class="exam-question-label">QUESTION @(index + 1)</span>
                        <h2>@question.QuestionText</h2>
                        @if (localImage)
                        {
                            <img class="exam-question-image" src="@Url.Content(imagePath!)" alt="Question illustration" loading="eager" />
                        }
                        <div class="exam-answer-options" role="group" aria-label="Answer choices">
                            @foreach (var (letter, text) in new[] { ("A", question.OptionA), ("B", question.OptionB), ("C", question.OptionC), ("D", question.OptionD), ("E", question.OptionE) })
                            {
                                if (!string.IsNullOrWhiteSpace(text))
                                {
                                    <label class="exam-answer-option">
                                        <input type="radio" name="choice-@question.QuestionId" value="@letter" checked="@(string.Equals(saved, letter, StringComparison.OrdinalIgnoreCase))" />
                                        <span class="exam-answer-letter">@letter</span>
                                        <span>@text</span>
                                    </label>
                                }
                            }
                        </div>
                        <input type="hidden" name="answers[@question.QuestionId]" value="@saved" data-answer="@question.QuestionId" />
                    </section>
                }
                <div class="exam-taking-controls">
                    <button type="button" class="btn btn-outline-secondary" id="examBack" @(backAllowed ? null : "hidden")><i class="bi bi-chevron-left" aria-hidden="true"></i> Back</button>
                    <button type="button" class="btn btn-outline-secondary" id="examClear">Clear answer</button>
                    <button type="button" class="btn btn-outline-secondary" id="examReviewToggle"><i class="bi bi-bookmark" aria-hidden="true"></i> Mark for review</button>
                    <button type="button" class="btn btn-primary" id="examNext">Next question <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
                <div class="exam-taking-save-status" id="examSaveStatus" role="status" aria-live="polite">Saved answers are stored securely on the server.</div>
                <div class="exam-taking-submit">
                    <div><strong>Finish this session</strong><p>Review your answers before submission. You cannot edit a submitted session.</p></div>
                    <button id="submitExamSession" type="submit" class="btn btn-success"><i class="bi bi-check2-circle" aria-hidden="true"></i> Submit session</button>
                </div>
            </form>
        </section>
        <aside class="exam-taking-aside" aria-label="Question navigation and monitoring">
            <div class="exam-taking-panel">
                <h2>Question navigator</h2>
                <p class="small text-secondary">Filled = answered · Outline = not answered · Bookmark = review</p>
                <div class="exam-question-grid" id="examQuestionNavigator">
                    @for (var index = 0; index < questions.Count; index++)
                    {
                        <button type="button" class="exam-question-jump" data-jump="@index" aria-label="Open question @(index + 1)" @(backAllowed ? null : "disabled")>@(index + 1)</button>
                    }
                </div>
                @if (!backAllowed)
                {
                    <p class="small text-secondary mt-2 mb-0">Back navigation is disabled by the examination rules. Use Next or Skip.</p>
                }
            </div>
            <div class="exam-taking-panel exam-monitoring-panel" id="examDeviceDetails">
                <h2>Exam monitoring</h2>
                <video id="proctorCamera" muted autoplay playsinline aria-label="Your live examination camera" class="exam-taking-camera"></video>
                <p class="small text-secondary mb-2">Your examination is monitored. An AI observation alone is not a confirmed misconduct finding.</p>
                <div class="exam-monitoring-status" role="status" aria-live="polite">
                    <p><strong>Devices:</strong> <span id="mediaStatus">Connecting…</span></p>
                    <p><strong>Identity:</strong> <span id="identityMonitorStatus">Checking…</span></p>
                    <p><strong>Attention:</strong> <span id="behaviorMonitorStatus">Checking…</span></p>
                    <button type="button" id="calibrateScreenView" class="btn btn-outline-secondary btn-sm mb-2">Calibrate screen edges</button>
                    <p><strong>Presence:</strong> <span id="absenceMonitorStatus">Checking…</span></p>
                    <p><strong>Multiple people:</strong> <span id="peopleMonitorStatus">Checking…</span></p>
                    <p><strong>Objects:</strong> <span id="objectMonitorStatus">Checking…</span></p>
                    <p><strong>Audio:</strong> <span id="speechMonitorStatus">Checking…</span></p>
                    <p><strong>Evidence:</strong> <span id="evidenceStatus">Preparing…</span></p>
                </div>
                <p class="small" id="liveDisplayStatus" role="status">Checking live display…</p>
                <button type="button" id="restoreExamDisplay" class="btn btn-outline-primary btn-sm" data-screen-permission hidden>Restore display sharing</button>
                @if (Model.Exam.RequireFullscreen)
                {
                    <p id="examFullscreenStatus" class="small mb-1" role="status">Select Enter fullscreen to enable exam fullscreen.</p>
                    <button type="button" id="fullscreenStatusPill" class="btn btn-outline-primary btn-sm" aria-describedby="examFullscreenStatus">Enter fullscreen</button>
                }
                <details class="exam-monitoring-details mt-3"><summary>Having camera or microphone trouble?</summary><p class="small mb-0 mt-2">Check your browser site permissions and device connection. Do not start another attempt. Ask your Teacher for help if the issue continues.</p></details>
            </div>
            <form asp-area="Student" asp-controller="Exam" asp-action="PauseOwnAttempt" method="post" id="examPauseForm" target="_top">
                @Html.AntiForgeryToken()
                <input type="hidden" name="attemptId" value="@Model.SessionAttempt.AttemptId" />
                <button type="submit" class="btn btn-outline-warning w-100">Request a pause (Teacher approval needed)</button>
            </form>
        </aside>
    </div>
    <noscript><div class="alert alert-danger">JavaScript is required to keep your examination monitored and save answers securely. Enable it and reopen your session.</div></noscript>
</div>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/exam-http.js" asp-append-version="true"></script>
    <script src="~/js/media-capabilities.js" asp-append-version="true"></script>
    <script src="~/js/exam-browser-guard.js" asp-append-version="true"></script>
    <script src="~/js/exam-display-capture.js" asp-append-version="true"></script>
    <script src="~/js/live-proctoring.js" asp-append-version="true"></script>
    <script src="~/js/speech-stream.js" asp-append-version="true"></script>
    <script src="~/js/proctoring-client.js" asp-append-version="true"></script>
    <script>
        window.examSessionMonitoringConfig = {
            attemptId: @Model.SessionAttempt.AttemptId,
            sessionId: @Model.SessionAttempt.SessionAttemptId,
            requireFullscreen: @Model.Exam.RequireFullscreen.ToString().ToLowerInvariant(),
            owner: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)),
            identityFrames: @FaceOptions.Value.ContinuousVerificationFrames,
            identitySeconds: @FaceOptions.Value.ContinuousVerificationSeconds,
            baselineFrames: @BehaviorOptions.Value.BaselineFrames,
            urls: {
                identity: '@Url.Action("VerifyActiveIdentity", "Exam", new { area = "Student" })',
                baseline: '@Url.Action("StartBehaviorSession", "Exam", new { area = "Student" })',
                behavior: '@Url.Action("AnalyzeBehavior", "Exam", new { area = "Student" })',
                objects: '@Url.Action("AnalyzeObjects", "Exam", new { area = "Student" })',
                health: '@Url.Action("DeviceHealth", "Exam", new { area = "Student" })',
                log: '@Url.Action("LogProctoring", "Exam", new { area = "Student" })',
                detect: '@Url.Action("DetectSpeech", "Exam", new { area = "Student" })',
                transcribe: '@Url.Action("TranscribeSpeech", "Exam", new { area = "Student" })',
                speech: '@Url.Action("SpeechStream", "Exam", new { area = "Student" })',
                evidence: '@Url.Action("AbsenceEvidence", "Exam", new { area = "Student" })',
                recording: '@Url.Action("UploadRecordingSegment", "Exam", new { area = "Student" })'
            }
        };
    </script>
    <script src="~/js/exam-attempt-state.js" asp-append-version="true"></script>
    <script src="~/js/exam-attempt-v2.js" asp-append-version="true"></script>
}
