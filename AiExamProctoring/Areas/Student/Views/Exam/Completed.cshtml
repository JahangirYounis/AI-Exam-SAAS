@model AiExamProctoring.Models.ExamSessionAttempt
@{
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Submission confirmed";
    var finished = Model.Attempt?.Status == AiExamProctoring.Models.AttemptStatus.Completed;
}
<section class="student-card p-4 p-md-5 mx-auto text-center" style="max-width:760px" aria-labelledby="completion-title">
    <i class="bi bi-check-circle-fill text-success display-3" aria-hidden="true"></i>
    <h1 id="completion-title" class="mt-3">@(finished ? "Exam Submitted Successfully!" : "Session Submitted Successfully!")</h1>
    <p class="soft-muted">Your answers have been saved and your submission is confirmed.</p>
    <p class="fw-semibold">@Model.Attempt?.Exam?.ExamTitle — @Model.Session?.SessionTitle</p>
    <p>Submitted: <strong>@(Model.CompletedAt?.ToString("dd MMM yyyy, hh:mm:ss tt") ?? "Recorded")</strong></p>
    <div class="d-flex gap-3 justify-content-center flex-wrap mt-4">
        @if (finished)
        {
            <a asp-action="AttemptResult" asp-route-attemptId="@Model.AttemptId" class="btn btn-primary">View Result / Certificate</a>
        }
        else
        {
            <a asp-action="Break" asp-route-attemptId="@Model.AttemptId" class="btn btn-primary">Continue to next session</a>
        }
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Return to Dashboard</a>
    </div>
</section>
