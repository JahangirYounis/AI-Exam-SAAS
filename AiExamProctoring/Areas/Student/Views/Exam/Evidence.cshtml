@model List<AiExamProctoring.Models.ProctoringLog>
@{ViewData["Title"]="My exam evidence";var attempts=ViewBag.Attempts as List<AiExamProctoring.Models.ExamAttempt> ?? new();}
<h1>My exam evidence</h1><p>Recorded observations are available for review; a detector output alone is not proof of cheating.</p>
<form method="get"><select name="attemptId" class="form-select" onchange="this.form.submit()"><option value="">All my attempts</option>@foreach(var a in attempts){<option value="@a.AttemptId">@a.Exam?.ExamTitle — attempt @a.AttemptId</option>}</select></form>
@foreach(var l in Model){<article class="card p-3 my-3"><h3>@l.AlertTypeDisplay</h3><p>@l.CreatedDate.ToString("dd MMM yyyy hh:mm:ss tt")</p><p>@l.Description</p>@if(l.ScreenshotPath!=null){<a asp-action="AuditEvidence" asp-route-attemptId="@l.AttemptId" asp-route-id="@l.LogId" asp-route-kind="screenshot" target="_blank">Screenshot</a>}@if(l.RecordingPath!=null){<a asp-action="AuditEvidence" asp-route-attemptId="@l.AttemptId" asp-route-id="@l.LogId" asp-route-kind="recording" target="_blank">Audio / session clip</a>}@if(l.VideoEvidencePath!=null){<a asp-action="AuditEvidence" asp-route-attemptId="@l.AttemptId" asp-route-id="@l.LogId" asp-route-kind="video" target="_blank">Camera event video</a>}@if(l.ScreenshotPath==null&&l.RecordingPath==null&&l.VideoEvidencePath==null){<p class="text-warning">No media was saved for this observation.</p>}@if(l.SpeechTranscript!=null){<details><summary>Transcript</summary><p>@l.SpeechTranscript</p></details>}</article>}
