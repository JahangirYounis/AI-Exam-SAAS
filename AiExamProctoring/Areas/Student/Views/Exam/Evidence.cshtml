@model List<AiExamProctoring.Models.ProctoringLog>
@{ ViewData["Title"] = "Examination review status"; }
<div class="container py-4">
    <h1 class="h3 fw-bold">Examination review status</h1>
    <p class="text-secondary">Monitoring observations are assessed by the examination Teacher. A recorded observation does not automatically mean cheating.</p>
    <p>Raw screenshots, recordings, speech transcripts and associated private metadata are available only to authorized Teachers. They are not displayed in this view.</p>
    <a asp-area="" asp-controller="SharedEvidence" asp-action="Index" class="btn btn-outline-primary">View evidence explicitly shared with me</a>
</div>
