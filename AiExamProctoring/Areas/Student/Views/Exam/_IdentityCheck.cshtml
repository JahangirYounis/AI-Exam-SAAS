@using System
@model AiExamProctoring.Models.ExamSessionAttempt
@inject Microsoft.Extensions.Options.IOptions<AiExamProctoring.Services.FaceIdentity.FaceIdentityOptions> FaceOptions
@if (Model is null || Model.AttemptId <= 0 || Model.SessionAttemptId <= 0)
{
    <div class="alert alert-danger" role="alert">
        The examination session could not be identified. Return to your examinations and try again.
        <a asp-area="Student" asp-controller="Exam" asp-action="Available">My examinations</a>
    </div>
}
else
{
    <section class="alert alert-light border" aria-label="Exam camera connection">
        <p class="mb-1">کیمرے سے رابطہ ہو رہا ہے۔ براہ کرم سامنے دیکھیں۔<br />Connecting your camera. Please look at the screen.</p>
        <video id="entryCamera" autoplay muted playsinline class="w-100 rounded-3 bg-dark" style="max-height:360px"></video>
        <form id="entryIdentityForm">
            @Html.AntiForgeryToken()
            <button id="verifyEntry" type="submit" class="btn btn-primary mt-3">Check camera and identity</button>
        </form>
        <p id="entryStatus" role="status" aria-live="polite" class="mt-3">Camera access is required.</p>
        <noscript><p role="alert">Enable JavaScript to connect your camera and verify your identity.</p></noscript>
    </section>
    <div data-proctoring-attempt="@Model.AttemptId"></div>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/proctoring-client.js" asp-append-version="true"></script>
    <script>
        (() => {
            function initialize() {
                const form = document.getElementById('entryIdentityForm');
                const video = document.getElementById('entryCamera');
                const button = document.getElementById('verifyEntry');
                const status = document.getElementById('entryStatus');
                if (!form || !video || !button || !status || form.dataset.ready === 'true') return;
                form.dataset.ready = 'true';
                let stream;
                let leaving = false;
                const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
                const stopCamera = () => { stream?.getTracks().forEach(track => track.stop()); stream = null; };
                const blocked = () => window.ProctoringRealtime?.blocked === true;
                async function verify(event) {
                    event?.preventDefault();
                    if (button.disabled || blocked() || leaving) return;
                    button.disabled = true;
                    try {
                        if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia)
                            throw new Error('Camera access requires a supported browser and a trusted HTTPS connection.');
                        status.textContent = 'Starting camera…';
                        if (!stream?.getVideoTracks().some(track => track.readyState === 'live')) {
                            let expired = false;
                            let timer;
                            try {
                                stream = await Promise.race([
                                    navigator.mediaDevices.getUserMedia({ video: { width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false })
                                        .then(camera => {
                                            if (expired || leaving) { camera.getTracks().forEach(track => track.stop()); throw new Error('Camera request expired. Please retry.'); }
                                            return camera;
                                        }),
                                    new Promise((_, reject) => { timer = setTimeout(() => {
                                        expired = true;
                                        reject(new Error('Please allow camera access in your browser, then retry.'));
                                    }, 20000); })
                                ]);
                            } finally { clearTimeout(timer); }
                            video.srcObject = stream;
                            await video.play();
                            await delay(1500);
                        }
                        if (blocked() || leaving) return;
                        const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (!token) throw new Error('Your security token is missing. Reload this page and retry.');
                        if (!video.videoWidth || !video.videoHeight) throw new Error('Camera is still starting. Please retry.');
                        const body = new FormData();
                        body.append('AttemptId', '@Model.AttemptId');
                        body.append('SessionAttemptId', '@Model.SessionAttemptId');
                        body.append('__RequestVerificationToken', token);
                        const canvas = document.createElement('canvas');
                        canvas.width = Math.min(1280, video.videoWidth);
                        canvas.height = Math.round(canvas.width * video.videoHeight / video.videoWidth);
                        const context = canvas.getContext('2d');
                        if (!context) throw new Error('This browser could not capture a camera image.');
                        status.textContent = 'Checking your identity. Keep your face visible…';
                        for (let i = 0; i < @FaceOptions.Value.ContinuousVerificationFrames; i++) {
                            if (blocked() || leaving) return;
                            context.drawImage(video, 0, 0, canvas.width, canvas.height);
                            const frame = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.9));
                            if (!frame) throw new Error('Camera frame unavailable. Please retry.');
                            body.append('Frames', frame, `entry-${i}.jpg`);
                            await delay(280);
                        }
                        const abort = new AbortController();
                        const timeout = setTimeout(() => abort.abort(), 45000);
                        let response;
                        try {
                            response = await fetch('@Url.Action("VerifyActiveIdentity", "Exam", new { area = "Student" })', {
                                method: 'POST', credentials: 'same-origin', body, signal: abort.signal
                            });
                        } finally { clearTimeout(timeout); }
                        if (!(response.headers.get('content-type') || '').includes('application/json'))
                            throw new Error(response.redirected ? 'Your sign-in may have expired. Reload this page and sign in again.' : 'The server could not complete verification. Please retry or contact your teacher.');
                        const result = await response.json();
                        if (result.blocked || response.status === 423) {
                            status.textContent = 'This examination is locked for teacher review.';
                            stopCamera();
                            if (result.state) window.ProctoringRealtime?.apply(result.state);
                            await window.ProctoringRealtime?.sync();
                            return;
                        }
                        if (blocked() || leaving) return;
                        if (!response.ok || !result.verified || !result.entryTicket || !result.redirectUrl)
                            throw new Error(result.message || 'Identity could not be confirmed. Please retry or contact your teacher.');
                        const destination = new URL(result.redirectUrl, window.location.origin);
                        if (destination.origin !== window.location.origin)
                            throw new Error('The server returned an invalid examination address. Contact your teacher.');
                        destination.searchParams.set('entryTicket', result.entryTicket);
                        status.textContent = 'Verified. Opening your paper…';
                        leaving = true;
                        stopCamera();
                        window.location.replace(destination.href);
                    } catch (error) {
                        if (blocked() || leaving) return;
                        status.textContent = error.name === 'AbortError' ? 'Verification timed out. Please retry.'
                            : error.name === 'NotAllowedError' ? 'Camera permission was denied. Allow the camera in your browser, then retry.'
                            : error.message || 'Verification unavailable. Please retry or contact your teacher.';
                    } finally {
                        button.disabled = leaving || blocked();
                        button.textContent = 'Retry camera check';
                    }
                }
                form.addEventListener('submit', verify);
                window.addEventListener('pagehide', () => { leaving = true; stopCamera(); });
                verify();
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once: true });
            else initialize();
        })();
    </script>
}
