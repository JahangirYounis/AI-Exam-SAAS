@{
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Submission needs attention";
    Context.Response.Headers["Cache-Control"] = "no-store";
}
<section class="student-card p-3 p-md-5 mx-auto" style="max-width:780px" aria-labelledby="submission-problem-title">
    <div class="d-flex align-items-start gap-3 mb-3">
        <span class="rounded-3 bg-warning-subtle text-warning-emphasis p-3"><i class="bi bi-cloud-slash fs-4" aria-hidden="true"></i></span>
        <div>
            <p class="text-warning-emphasis text-uppercase fw-bold small mb-1">Submission not confirmed</p>
            <h1 id="submission-problem-title" class="h3 fw-bold mb-2">Your answers are still protected</h1>
            <p class="text-secondary mb-0">The server could not confirm the final submission. Previously saved answers remain in the examination database.</p>
        </div>
    </div>
    <div class="alert alert-warning" role="alert">@(ViewBag.SubmissionMessage as string ?? "Open your examination session and follow the instructions to try again.")</div>
    <div class="d-flex flex-wrap gap-2">
        @if (ViewBag.SessionAttemptId is int sessionId && sessionId > 0)
        {
            <a asp-area="Student" asp-controller="Exam" asp-action="Session" asp-route-sessionAttemptId="@sessionId" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Reopen session securely</a>
        }
        <a asp-area="Student" asp-controller="Exam" asp-action="Available" class="btn btn-outline-secondary">My Examinations</a>
    </div>
    <p class="small text-secondary mt-4 mb-0">Do not create a new examination attempt. If the issue continues, give your teacher this support reference: <code>@Context.TraceIdentifier</code></p>
</section>
