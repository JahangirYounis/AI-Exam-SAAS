@using AiExamProctoring.Models
@using AiExamProctoring.Services.Results
@model AiExamProctoring.ViewModels.Student.StudentDashboardViewModel
@{
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    if (Model is null)
    {
        <section class="student-card p-4" role="alert">
            <h1 class="h4">Dashboard unavailable</h1>
            <p>@(ViewBag.DashboardLoadError as string ?? "Please try again.")</p>
            <a asp-area="Student" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Retry</a>
        </section>
        return;
    }
    var active = Model.OngoingAttempts;
    var held = Model.BlockedAttempts;
    var profileIssues = Model.MissingProfileFields;
    var firstActive = active.FirstOrDefault();
    var firstHeld = held.FirstOrDefault();
    var needsStatusCheck = Model.NeedsStatusCheckAttempts;
    var nextExam = Model.AvailableExams.FirstOrDefault();
    var recentResults = Model.RecentResults;
    var notifications = Model.Notifications;
}
<section class="candidate-dashboard-v2" aria-labelledby="student-dashboard-title">
    <header class="sd-hero">
        <div>
            <span class="sd-eyebrow"><i class="bi bi-mortarboard" aria-hidden="true"></i> STUDENT WORKSPACE</span>
            <h1 id="student-dashboard-title">Welcome back, @Model.StudentName</h1>
            <p>See your examinations, review status and published results in one place.</p>
            <div class="sd-meta">
                <span><i class="bi bi-calendar3" aria-hidden="true"></i> @Model.CurrentDate.ToString("dd MMMM yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(Model.RollNumber))
                {
                    <span><i class="bi bi-person-badge" aria-hidden="true"></i> @Model.RollNumber</span>
                }
            </div>
        </div>
        <a asp-area="Student" asp-controller="Exam" asp-action="Available" class="sd-hero-action">
            <i class="bi bi-journal-check" aria-hidden="true"></i> My examinations
        </a>
    </header>

    @if (profileIssues.Count > 0)
    {
        <div class="sd-profile-reminder" role="status">
            <div class="sd-reminder-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></div>
            <div class="flex-grow-1 min-w-0">
                <strong>Profile details need attention</strong>
                <p>Missing: @string.Join(", ", profileIssues). Complete your details before an examination.</p>
                <small>Face enrollment and device readiness are verified separately during examination entry.</small>
            </div>
            <a asp-area="Student" asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-primary">Review profile</a>
        </div>
    }

    <section class="sd-stats" aria-label="Your examination overview">
        <a asp-area="Student" asp-controller="Exam" asp-action="Available" asp-route-view="current" class="sd-stat">
            <span class="sd-stat-icon blue"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
            <strong>@Model.AvailableExamCount</strong><span>Entry open</span><small>Available to start now</small>
        </a>
        <a asp-area="Student" asp-controller="Exam" asp-action="Available" asp-route-view="resume" class="sd-stat">
            <span class="sd-stat-icon indigo"><i class="bi bi-play-circle" aria-hidden="true"></i></span>
            <strong>@Model.OngoingExamCount</strong><span>Can continue</span><small>Eligible active attempts</small>
        </a>
        <a asp-area="Student" asp-controller="Exam" asp-action="Available" asp-route-view="blocked" class="sd-stat">
            <span class="sd-stat-icon amber"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span>
            <strong>@Model.BlockedAttemptCount</strong><span>Blocked / held</span><small>Teacher decision required</small>
        </a>
        <a asp-area="Student" asp-controller="Result" asp-action="Index" class="sd-stat">
            <span class="sd-stat-icon green"><i class="bi bi-award" aria-hidden="true"></i></span>
            <strong>@Model.ReleasedResultCount</strong><span>Released results</span><small>@Model.PassedExamCount passed</small>
        </a>
    </section>

    <div class="sd-columns">
        <div class="sd-main-column">
            @if (firstActive is not null || firstHeld is not null || needsStatusCheck.Count > 0)
            {
                <section class="sd-panel" aria-labelledby="student-attempt-heading">
                    <div class="sd-panel-header"><div><h2 id="student-attempt-heading">Your examination status</h2><p>Continue eligible tests or check held attempts.</p></div>
                    <a asp-area="Student" asp-controller="Exam" asp-action="Available" class="sd-link">View all</a></div>
                    @foreach (var attempt in active.Take(2))
                    {
                        <div class="sd-list-row">
                            <div class="sd-row-icon"><i class="bi bi-play-circle" aria-hidden="true"></i></div>
                            <div class="sd-row-text"><strong>@(attempt.Exam?.ExamTitle ?? "Examination")</strong><small>Attempt #@attempt.AttemptId · In progress</small></div>
                            <a asp-area="Student" asp-controller="Exam" asp-action="Resume" asp-route-attemptId="@attempt.AttemptId" class="btn btn-sm btn-primary">Continue</a>
                        </div>
                    }
                    @foreach (var attempt in needsStatusCheck.Take(2))
                    {
                        <div class="sd-list-row">
                            <div class="sd-row-icon muted"><i class="bi bi-clock-history" aria-hidden="true"></i></div>
                            <div class="sd-row-text"><strong>@(attempt.Exam?.ExamTitle ?? "Examination")</strong><small>Attempt #@attempt.AttemptId · Time or state requires verification</small></div>
                            <a asp-area="Student" asp-controller="Exam" asp-action="Resume" asp-route-attemptId="@attempt.AttemptId" class="btn btn-sm btn-outline-secondary">Check status</a>
                        </div>
                    }
                    @foreach (var attempt in held.Take(2))
                    {
                        <div class="sd-list-row">
                            <div class="sd-row-icon warning"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
                            <div class="sd-row-text"><strong>@(attempt.Exam?.ExamTitle ?? "Examination")</strong><small>Attempt #@attempt.AttemptId · Teacher review required</small></div>
                            <a asp-area="Student" asp-controller="Exam" asp-action="Blocked" asp-route-attemptId="@attempt.AttemptId" class="btn btn-sm btn-outline-warning">Review status</a>
                        </div>
                    }
                </section>
            }

            <section class="sd-panel" aria-labelledby="student-exams-heading">
                <div class="sd-panel-header"><div><h2 id="student-exams-heading">Available and upcoming</h2><p>Examinations assigned to you or open to eligible candidates.</p></div>
                <a asp-area="Student" asp-controller="Exam" asp-action="Available" class="sd-link">View all</a></div>
                @foreach (var exam in Model.AvailableExams.Take(2))
                {
                    <div class="sd-list-row">
                        <div class="sd-row-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></div>
                        <div class="sd-row-text"><strong>@exam.ExamTitle</strong><small>@exam.DurationMinutes min · @exam.TotalQuestions questions · Entry open</small></div>
                        <a asp-area="Student" asp-controller="Exam" asp-action="PreCheck" asp-route-examId="@exam.ExamId" class="btn btn-sm btn-outline-primary">Prepare</a>
                    </div>
                }
                @foreach (var exam in Model.UpcomingExams.Take(2))
                {
                    <div class="sd-list-row">
                        <div class="sd-row-icon muted"><i class="bi bi-calendar-event" aria-hidden="true"></i></div>
                        <div class="sd-row-text"><strong>@exam.ExamTitle</strong><small>@exam.StartDate.ToString("dd MMM yyyy, hh:mm tt") · Upcoming</small></div>
                        <a asp-area="Student" asp-controller="Exam" asp-action="Available" asp-route-view="upcoming" class="btn btn-sm btn-outline-secondary">Schedule</a>
                    </div>
                }
                @if (Model.AvailableExams.Count == 0 && Model.UpcomingExams.Count == 0)
                {
                    <div class="sd-empty"><i class="bi bi-calendar2-check" aria-hidden="true"></i><p>No new tests available right now.</p><a asp-area="Student" asp-controller="Exam" asp-action="Available">Check examinations</a></div>
                }
            </section>

            <section class="sd-panel" aria-labelledby="student-results-heading">
                <div class="sd-panel-header"><div><h2 id="student-results-heading">Latest released results</h2><p>Only marks officially released to your account.</p></div>
                <a asp-area="Student" asp-controller="Result" asp-action="Index" class="sd-link">All results</a></div>
                @foreach (var result in recentResults.Take(3))
                {
                    <div class="sd-list-row">
                        <div class="sd-row-icon green"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i></div>
                        <div class="sd-row-text"><strong>@(result.Attempt?.Exam?.ExamTitle ?? "Examination")</strong><small>@result.TotalMarksObtained.ToString("0.##") / @result.TotalMarks.ToString("0.##") · @result.Percentage.ToString("0.#")% · @StudentResultAccess.GradeLabel(result.Percentage, result.Attempt?.Exam?.PassingPercentage ?? 100m)</small></div>
                        <a asp-area="Student" asp-controller="Result" asp-action="Details" asp-route-id="@result.ResultId" class="btn btn-sm btn-outline-primary">View</a>
                    </div>
                }
                @if (recentResults.Count == 0)
                {
                    <div class="sd-empty"><i class="bi bi-clipboard-data" aria-hidden="true"></i><p>No results released yet.</p><a asp-area="Student" asp-controller="Result" asp-action="Index">Check review status</a></div>
                }
            </section>
        </div>

        <div class="sd-side-column">
            <section class="sd-panel" aria-labelledby="student-action-heading">
                <div class="sd-panel-header"><div><h2 id="student-action-heading">Quick actions</h2></div></div>
                <div class="sd-action-list">
                    <a asp-area="Student" asp-controller="Exam" asp-action="Available"><i class="bi bi-journal-check" aria-hidden="true"></i> Browse examinations <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    <a asp-area="Student" asp-controller="Result" asp-action="Index"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Results &amp; reviews <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    <a asp-area="Student" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-badge" aria-hidden="true"></i> My profile <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    <a asp-area="" asp-controller="SharedEvidence" asp-action="Index"><i class="bi bi-share" aria-hidden="true"></i> Items shared with me <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </div>
            </section>
            <section class="sd-panel" aria-labelledby="student-updates-heading">
                <div class="sd-panel-header"><div><h2 id="student-updates-heading">Recent updates</h2></div>
                <a asp-area="Student" asp-controller="Notification" asp-action="Index" class="sd-link">View history</a></div>
                @foreach (var item in notifications.Take(3))
                {
                    <div class="sd-update"><span class="sd-update-dot @(item.IsRead ? "read" : "")"></span>
                        <div><strong>@item.Title</strong><p>@item.Message</p><small>@item.Date.ToString("dd MMM yyyy, hh:mm tt")</small></div></div>
                }
                @if (notifications.Count == 0)
                {
                    <div class="sd-empty small"><p>No recent notifications.</p></div>
                }
            </section>
        </div>
    </div>
</section>
