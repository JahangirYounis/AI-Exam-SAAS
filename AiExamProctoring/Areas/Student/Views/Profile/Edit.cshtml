@model AiExamProctoring.ViewModels.Student.StudentProfileViewModel
@using AiExamProctoring.Models
@{ Layout="~/Areas/Student/Views/Shared/_StudentLayout.cshtml"; ViewData["Title"]="Manage Profile"; var img=string.IsNullOrWhiteSpace(Model.ProfileImage)?Url.Content("~/images/default-user.svg"):Model.ProfileImage; var section=Context.Request.Query["section"].ToString(); var returnUrl=ViewBag.ReturnUrl as string; var requirePhoto=ViewBag.RequirePhoto == true; }

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><span class="eyebrow">Student profile</span><h1 class="fw-bold mb-1">Manage Profile</h1><p class="soft-muted mb-0">Identity, address, education, experience and certifications are maintained separately.</p></div><a asp-action="Index" class="btn btn-light rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i>Back to profile</a></div>

<nav class="profile-tabs student-card p-2 mb-4" aria-label="Profile sections">
  <a href="#personal" class="@(section==""?"active":"")"><i class="bi bi-person-vcard"></i>Personal</a>
  <a href="#address"><i class="bi bi-geo-alt"></i>Address</a>
  <a href="#education" class="@(section=="education"?"active":"")"><i class="bi bi-mortarboard"></i>Education</a>
  <a href="#experience" class="@(section=="experience"?"active":"")"><i class="bi bi-briefcase"></i>Experience</a>
  <a href="#certification" class="@(section=="certification"?"active":"")"><i class="bi bi-patch-check"></i>Certificates</a>
</nav>

@if (!string.IsNullOrWhiteSpace(returnUrl))
{
  <div class="alert alert-warning border-0 rounded-4 mb-4"><div class="d-flex gap-3"><i class="bi bi-camera-fill fs-4"></i><div><strong>Profile and Face Identity required before examination</strong><div class="small mt-1">Save a profile photo, then use the Model 1 button to create your multi-photo identity template.</div></div></div></div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data" data-prevent-double-submit>
@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="ProfileImage" type="hidden"/><input type="hidden" name="returnUrl" value="@returnUrl"/>
<div asp-validation-summary="All" class="alert alert-danger rounded-4"></div>
<div class="row g-4">
  <div class="col-xl-4">
    <div class="student-card p-4 text-center sticky-profile-editor">
      <img id="profilePreview" src="@img" class="profile-edit-photo" alt="Profile preview" onerror="this.onerror=null;this.src='@Url.Content("~/images/default-user.svg")';" />
      <h4 class="fw-bold mt-3 mb-1">Candidate &amp; certificate photo</h4><p class="small soft-muted">Use a recent, clear front-facing photo. It is securely saved in your profile and printed on your certificate.</p>
      <input asp-for="ImageFile" class="form-control" accept="image/jpeg,image/png" capture="user" id="profileImageInput" required="@(requirePhoto || string.IsNullOrWhiteSpace(Model.ProfileImage) ? "required" : null)"/><span asp-validation-for="ImageFile" class="text-danger small"></span>
      <div class="identity-security-note mt-3"><i class="bi bi-shield-check"></i><span>JPG/PNG · Max 5 MB · profile/certificate photo</span></div>
      <a asp-action="FaceIdentity" class="btn btn-outline-primary rounded-pill w-100 mt-3"><i class="bi bi-person-bounding-box me-1"></i>Manage Face Identity Model 1</a>
      <hr/><div class="small soft-muted">Account status</div><span class="badge-soft @(Model.IsApproved?"soft-success":"soft-warning") mt-2 d-inline-block">@(Model.IsApproved?"Approved candidate":"Pending approval")</span>
    </div>
  </div>
  <div class="col-xl-8">
    <section id="personal" class="student-card p-4 mb-4 profile-form-section"><div class="profile-section-head"><div><span class="profile-kicker">Personal details</span><h2>Personal & account information</h2></div><i class="bi bi-person-vcard"></i></div>
      <div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly/></div><div class="col-md-6"><label asp-for="FatherName" class="form-label">Father / Guardian name</label><input asp-for="FatherName" class="form-control"/></div><div class="col-md-6"><label asp-for="CNIC" class="form-label"></label><input asp-for="CNIC" class="form-control" placeholder="42101-1234567-1"/></div><div class="col-md-4"><label asp-for="PhoneNumber" class="form-label">Mobile number</label><input asp-for="PhoneNumber" class="form-control"/></div><div class="col-md-4"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option value="">Select</option><option>Male</option><option>Female</option><option>Other</option></select></div><div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="CandidateNumber" class="form-label">Permanent Candidate ID</label><input asp-for="CandidateNumber" class="form-control" readonly/><div class="form-text">System-generated and cannot be changed.</div></div><div class="col-md-6"><label asp-for="TestingOrganization" class="form-label">Testing organization</label><input asp-for="TestingOrganization" class="form-control" placeholder="University, school or testing service"/></div></div>
    </section>

    <section id="address" class="student-card p-4 mb-4 profile-form-section"><div class="profile-section-head"><div><span class="profile-kicker">Address</span><h2>Address & domicile information</h2></div><i class="bi bi-geo-alt"></i></div>
      <div class="row g-3"><div class="col-md-4"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control"/></div><div class="col-md-4"><label asp-for="District" class="form-label">Domicile district</label><input asp-for="District" class="form-control"/></div><div class="col-md-4"><label asp-for="DomicileTaluka" class="form-label">Taluka / Tehsil</label><input asp-for="DomicileTaluka" class="form-control"/></div><div class="col-md-6"><label asp-for="UnionCouncil" class="form-label">Union Council / Town Committee</label><input asp-for="UnionCouncil" class="form-control"/></div><div class="col-md-3"><label asp-for="DomicileNumber" class="form-label">Domicile no.</label><input asp-for="DomicileNumber" class="form-control"/></div><div class="col-md-3"><label asp-for="PrcNumber" class="form-label">PRC-D no.</label><input asp-for="PrcNumber" class="form-control"/></div><div class="col-md-4"><label asp-for="DomicileIssueDate" class="form-label">Domicile issue date</label><input asp-for="DomicileIssueDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="City" class="form-label">Current city</label><input asp-for="City" class="form-control"/></div><div class="col-md-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control"/></div><div class="col-12"><label asp-for="PermanentAddress" class="form-label">Permanent address</label><textarea asp-for="PermanentAddress" class="form-control" rows="2"></textarea></div><div class="col-12"><label asp-for="Address" class="form-label">Postal / current address</label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div></div>
    </section>

    <section class="student-card p-4 profile-form-section"><div class="profile-section-head"><div><span class="profile-kicker">Institution details</span><h2>Academic identity</h2></div><i class="bi bi-building"></i></div><p class="small soft-muted">Use this only for institution-specific student identifiers. Formal qualifications are added as separate education records below.</p>
      <div class="row g-3"><div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control"/></div><div class="col-md-6"><label asp-for="University" class="form-label"></label><input asp-for="University" class="form-control"/></div><div class="col-md-6"><label asp-for="Session" class="form-label">Academic Session</label><input asp-for="Session" class="form-control" placeholder="e.g. 2023-2027"/></div><div class="col-md-6"><label class="form-label">Exam Roll Number</label><input class="form-control" value="Generated separately for each assigned examination" readonly/><div class="form-text">Your roll number belongs to an examination, not to your permanent profile.</div></div></div>
      <div class="d-flex justify-content-end mt-4"><button class="btn btn-primary rounded-pill px-5" type="submit"><i class="bi bi-check2-circle me-1"></i>Save profile information</button></div>
    </section>
  </div>
</div>
</form>

<section id="education" class="student-card p-4 mt-4 profile-form-section"><div class="profile-section-head"><div><span class="profile-kicker">Education</span><h2>Education records</h2></div><span class="profile-count">@Model.Educations.Count saved</span></div>
@if(Model.Educations.Count>0){<div class="profile-record-list mb-4">@foreach(var x in Model.Educations){<article class="profile-record"><div class="record-icon"><i class="bi bi-mortarboard-fill"></i></div><div class="flex-grow-1"><h3>@x.DegreeTitle</h3><p class="mb-1">@x.InstituteName</p><div class="record-meta"><span>@x.QualificationLevel</span><span>@(x.IsCurrent?"In progress":x.PassingYear?.ToString()??"—")</span>@if(x.Percentage.HasValue){<span>@x.Percentage.Value.ToString("0.##")%</span>}@if(!string.IsNullOrWhiteSpace(x.GradeCgpaDivision)){<span>@x.GradeCgpaDivision</span>}</div></div><form asp-action="DeleteEducation" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.StudentEducationId"/><button class="btn btn-sm btn-light text-danger" type="submit" title="Remove"><i class="bi bi-trash3"></i></button></form></article>}</div>}
<form asp-action="AddEducation" method="post" class="profile-inline-form">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label class="form-label">Qualification level</label><select name="QualificationLevel" class="form-select" required><option value="">Select</option><option>Matric / SSC</option><option>Intermediate / HSSC</option><option>Diploma</option><option>Bachelor</option><option>Master</option><option>MPhil</option><option>PhD</option><option>Other</option></select></div><div class="col-md-4"><label class="form-label">Degree / certificate title</label><input name="DegreeTitle" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Institute name</label><input name="InstituteName" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Board / University</label><input name="BoardUniversity" class="form-control"/></div><div class="col-md-2"><label class="form-label">Passing year</label><input name="PassingYear" type="number" min="1950" max="2100" class="form-control"/></div><div class="col-md-2"><label class="form-label">Percentage</label><input name="Percentage" type="number" min="0" max="100" step=".01" class="form-control"/></div><div class="col-md-2"><label class="form-label">Grade / CGPA</label><input name="GradeCgpaDivision" class="form-control"/></div><div class="col-md-2 d-flex align-items-end"><label class="form-check mb-2"><input name="IsCurrent" value="true" type="checkbox" class="form-check-input"/> In progress</label></div><div class="col-12"><label class="form-label">Major / subjects</label><input name="MajorSubjects" class="form-control"/></div></div><button class="btn btn-outline-primary rounded-pill mt-3 px-4" type="submit"><i class="bi bi-plus-lg me-1"></i>Add education</button></form>
</section>

<section id="experience" class="student-card p-4 mt-4 profile-form-section"><div class="profile-section-head"><div><span class="profile-kicker">Experience</span><h2>Experience information</h2></div><span class="profile-count">@Model.Experiences.Count saved</span></div>
@if(Model.Experiences.Count>0){<div class="profile-record-list mb-4">@foreach(var x in Model.Experiences){<article class="profile-record"><div class="record-icon"><i class="bi bi-briefcase-fill"></i></div><div class="flex-grow-1"><h3>@x.JobTitle</h3><p class="mb-1">@x.OrganizationName</p><div class="record-meta"><span>@(x.StartDate?.ToString("MMM yyyy")??"—") - @(x.IsCurrentlyWorking?"Present":x.EndDate?.ToString("MMM yyyy")??"—")</span>@if(!string.IsNullOrWhiteSpace(x.EmploymentType)){<span>@x.EmploymentType</span>}</div></div><form asp-action="DeleteExperience" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.StudentExperienceId"/><button class="btn btn-sm btn-light text-danger" type="submit"><i class="bi bi-trash3"></i></button></form></article>}</div>}
<form asp-action="AddExperience" method="post" class="profile-inline-form">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label class="form-label">Organization</label><input name="OrganizationName" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Job title</label><input name="JobTitle" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Employment type</label><select name="EmploymentType" class="form-select"><option value="">Select</option><option>Full-time</option><option>Part-time</option><option>Contract</option><option>Internship</option><option>Freelance</option></select></div><div class="col-md-3"><label class="form-label">Start date</label><input name="StartDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">End date</label><input name="EndDate" type="date" class="form-control"/></div><div class="col-md-3 d-flex align-items-end"><label class="form-check mb-2"><input name="IsCurrentlyWorking" value="true" type="checkbox" class="form-check-input"/> Currently working</label></div><div class="col-12"><label class="form-label">Description</label><textarea name="Description" class="form-control" rows="2"></textarea></div></div><button class="btn btn-outline-primary rounded-pill mt-3 px-4" type="submit"><i class="bi bi-plus-lg me-1"></i>Add experience</button></form>
</section>

<section id="certification" class="student-card p-4 mt-4 profile-form-section"><div class="profile-section-head"><div><span class="profile-kicker">Certificates</span><h2>Certifications & diplomas</h2></div><span class="profile-count">@Model.Certifications.Count saved</span></div>
@if(Model.Certifications.Count>0){<div class="profile-record-list mb-4">@foreach(var x in Model.Certifications){<article class="profile-record"><div class="record-icon"><i class="bi bi-patch-check-fill"></i></div><div class="flex-grow-1"><h3>@x.Title</h3><p class="mb-1">@x.InstituteName</p><div class="record-meta">@if(!string.IsNullOrWhiteSpace(x.Duration)){<span>@x.Duration</span>}@if(x.StartDate.HasValue||x.EndDate.HasValue){<span>@(x.StartDate?.ToString("dd MMM yyyy")??"—") - @(x.EndDate?.ToString("dd MMM yyyy")??"—")</span>}</div></div><form asp-action="DeleteCertification" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.StudentCertificationId"/><button class="btn btn-sm btn-light text-danger" type="submit"><i class="bi bi-trash3"></i></button></form></article>}</div>}
<form asp-action="AddCertification" method="post" class="profile-inline-form">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label class="form-label">Certificate / diploma</label><input name="Title" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Institute name</label><input name="InstituteName" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Duration</label><input name="Duration" class="form-control" placeholder="e.g. 6 months"/></div><div class="col-md-3"><label class="form-label">Start date</label><input name="StartDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">End date</label><input name="EndDate" type="date" class="form-control"/></div></div><button class="btn btn-outline-primary rounded-pill mt-3 px-4" type="submit"><i class="bi bi-plus-lg me-1"></i>Add certification</button></form>
</section>

@section Scripts{
<partial name="_ValidationScriptsPartial" />
<script>document.getElementById('profileImageInput')?.addEventListener('change',function(){const f=this.files?.[0];if(!f)return;const r=new FileReader();r.onload=e=>document.getElementById('profilePreview').src=e.target.result;r.readAsDataURL(f);});</script>
}
