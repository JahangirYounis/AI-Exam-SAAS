@model AiExamProctoring.ViewModels.Student.StudentProfileViewModel
@{ Layout="~/Areas/Student/Views/Shared/_StudentLayout.cshtml"; ViewData["Title"]="My Profile"; var img=string.IsNullOrWhiteSpace(Model.ProfileImage)?Url.Content("~/images/default-user.svg"):Model.ProfileImage; var identityExists=ViewBag.IdentityTemplateExists == true; var identityPhotoCount=(int)(ViewBag.IdentityPhotoCount ?? 0); }

@if (TempData["Success"] is string success) { <div class="alert alert-success rounded-4">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger rounded-4">@error</div> }

<div class="profile-hero student-card mb-4">
  <div class="profile-cover"></div>
  <div class="p-4 p-lg-5 pt-0">
    <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end gap-3 profile-hero-row">
      <img src="@img" class="profile-avatar-large" alt="Profile photo" onerror="this.onerror=null;this.src='@Url.Content("~/images/default-user.svg")';" />
      <div class="flex-grow-1 text-center text-md-start">
        <h1 class="fw-bold mb-1">@Model.FullName</h1>
        <div class="soft-muted">@Model.Email</div>
        <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-2 mt-2">
          <span class="badge-soft @(Model.IsApproved?"soft-success":"soft-warning")">@(Model.IsApproved?"Verified candidate":"Approval pending")</span>
          @if(Model.IsBlocked){<span class="badge-soft soft-danger">Blocked</span>}
          @if(!string.IsNullOrWhiteSpace(Model.CandidateNumber)){<span class="badge-soft soft-primary">Candidate # @Model.CandidateNumber</span>}
        </div>
      </div>
      <a asp-action="FaceIdentity" class="btn btn-outline-primary rounded-pill">View identity photos</a>
      <a asp-action="Edit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-pencil-square me-1"></i>Manage Profile</a>
    </div>
  </div>
</div>

<section class="student-card p-4 mb-4 profile-section-card">
  <div class="profile-section-head"><div><span class="profile-kicker">Face identity</span><h2>Registration photo gallery</h2><p class="small soft-muted mb-0">These are the private photos captured during registration and used by Model 1.</p></div><span class="profile-count">@identityPhotoCount / 10 photos</span></div>
  @if (identityExists && identityPhotoCount > 0)
  {
    <div class="row g-3 mb-4">
      @for (var i = 0; i < identityPhotoCount; i++)
      {
        <div class="col-6 col-md-4 col-xl-2">
          <div class="border rounded-4 p-2 h-100 text-center">
            <img src="@Url.Action("EnrollmentPhoto", new { index = i })" class="rounded-3 w-100" style="height:145px;object-fit:cover" loading="lazy" alt="Identity photo @(i + 1)" />
            <div class="small fw-semibold my-2">Photo @(i + 1)</div>
            <form asp-action="RemoveIdentityPhoto" method="post" onsubmit="return confirm('Remove this identity photo?');">
              @Html.AntiForgeryToken()<input type="hidden" name="index" value="@i" />
              <button class="btn btn-sm btn-outline-danger rounded-pill w-100" type="submit" disabled="@(identityPhotoCount <= 5 ? "disabled" : null)"><i class="bi bi-trash3 me-1"></i>Remove</button>
            </form>
          </div>
        </div>
      }
    </div>
    @if (identityPhotoCount <= 5) { <div class="alert alert-info py-2">At least 5 photos are required. Add a new photo before removing one.</div> }
    @if (identityPhotoCount < 10)
    {
      <form asp-action="AddIdentityPhotos" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-9"><label class="form-label fw-semibold">Add new identity photos</label><input name="images" type="file" accept="image/jpeg,image/png" multiple required class="form-control"/><div class="form-text">You can add up to @(10 - identityPhotoCount) clear JPG/PNG photo(s). Each photo may be up to 5 MB.</div></div>
        <div class="col-md-3 d-grid"><button class="btn btn-primary rounded-pill" type="submit"><i class="bi bi-plus-circle me-1"></i>Add photos</button></div>
      </form>
    }
  }
  else if (ViewBag.IdentityServiceReady == false)
  {
    <div class="alert alert-warning mb-0">Identity gallery is temporarily unavailable. @ViewBag.IdentityServiceMessage</div>
  }
  else
  {
    <div class="profile-empty"><i class="bi bi-person-bounding-box"></i><div><strong>No identity gallery yet</strong><p>Complete face identity enrollment to save 5–10 registration photos.</p><a asp-action="FaceIdentity" class="btn btn-sm btn-primary rounded-pill">Create identity gallery</a></div></div>
  }
</section>

<div class="row g-4">
  <div class="col-xl-8">
    <section class="student-card p-4 mb-4 profile-section-card">
      <div class="profile-section-head"><div><span class="profile-kicker">Identity</span><h2>Personal information</h2></div><i class="bi bi-person-vcard"></i></div>
      <div class="profile-info-grid">
        <div><small>Full name</small><strong>@Model.FullName</strong></div><div><small>Father / Guardian name</small><strong>@(Model.FatherName??"—")</strong></div>
        <div><small>CNIC</small><strong>@(Model.CNIC??"—")</strong></div><div><small>Gender</small><strong>@(Model.Gender??"—")</strong></div>
        <div><small>Date of birth</small><strong>@(Model.DateOfBirth?.ToString("dd MMM yyyy")??"—")</strong></div><div><small>Mobile number</small><strong>@(Model.PhoneNumber??"—")</strong></div>
        <div><small>Email</small><strong>@Model.Email</strong></div><div><small>Current city / country</small><strong>@($"{Model.City ?? "—"}, {Model.Country ?? "—"}")</strong></div>
      </div>
    </section>

    <section class="student-card p-4 mb-4 profile-section-card">
      <div class="profile-section-head"><div><span class="profile-kicker">Location</span><h2>Address & domicile</h2></div><i class="bi bi-geo-alt"></i></div>
      <div class="profile-info-grid">
        <div><small>Province</small><strong>@(Model.Province??"—")</strong></div><div><small>Domicile district</small><strong>@(Model.District??Model.Domicile??"—")</strong></div>
        <div><small>Taluka / Tehsil</small><strong>@(Model.DomicileTaluka??"—")</strong></div><div><small>Union Council / Town</small><strong>@(Model.UnionCouncil??"—")</strong></div>
        <div><small>Domicile no.</small><strong>@(Model.DomicileNumber??"—")</strong></div><div><small>PRC-D no.</small><strong>@(Model.PrcNumber??"—")</strong></div>
        <div><small>Domicile issue date</small><strong>@(Model.DomicileIssueDate?.ToString("dd MMM yyyy")??"—")</strong></div><div><small>Permanent address</small><strong>@(Model.PermanentAddress??Model.Address??"—")</strong></div>
      </div>
    </section>

    <section class="student-card p-4 mb-4 profile-section-card">
      <div class="profile-section-head"><div><span class="profile-kicker">Education</span><h2>Education</h2></div><span class="profile-count">@Model.Educations.Count record(s)</span></div>
      @if(Model.Educations.Count==0){<div class="profile-empty"><i class="bi bi-mortarboard"></i><div><strong>No education records added</strong><p>Add Matric, Intermediate, Bachelor or other qualifications from Manage Profile.</p></div></div>}
      else{<div class="profile-record-list">@foreach(var item in Model.Educations){<article class="profile-record"><div class="record-icon"><i class="bi bi-mortarboard-fill"></i></div><div class="flex-grow-1"><div class="d-flex flex-wrap justify-content-between gap-2"><div><h3>@item.DegreeTitle</h3><span class="record-subtitle">@item.QualificationLevel</span></div><span class="record-year">@(item.IsCurrent?"In progress":item.PassingYear?.ToString()??"—")</span></div><p class="mb-1">@item.InstituteName</p><div class="record-meta">@if(!string.IsNullOrWhiteSpace(item.BoardUniversity)){<span><i class="bi bi-building"></i>@item.BoardUniversity</span>}@if(item.Percentage.HasValue){<span><i class="bi bi-percent"></i>@item.Percentage.Value.ToString("0.##")%</span>}@if(!string.IsNullOrWhiteSpace(item.GradeCgpaDivision)){<span><i class="bi bi-award"></i>@item.GradeCgpaDivision</span>}</div>@if(!string.IsNullOrWhiteSpace(item.MajorSubjects)){<div class="small soft-muted mt-2">Major / Subjects: @item.MajorSubjects</div>}</div></article>}</div>}
    </section>

    <section class="student-card p-4 mb-4 profile-section-card">
      <div class="profile-section-head"><div><span class="profile-kicker">Experience</span><h2>Experience</h2></div><span class="profile-count">@Model.Experiences.Count record(s)</span></div>
      @if(Model.Experiences.Count==0){<div class="profile-empty"><i class="bi bi-briefcase"></i><div><strong>No experience records added</strong><p>This section stays optional for fresh candidates.</p></div></div>}
      else{<div class="profile-record-list">@foreach(var item in Model.Experiences){<article class="profile-record"><div class="record-icon"><i class="bi bi-briefcase-fill"></i></div><div class="flex-grow-1"><h3>@item.JobTitle</h3><p class="mb-1">@item.OrganizationName</p><div class="record-meta"><span><i class="bi bi-calendar3"></i>@(item.StartDate?.ToString("MMM yyyy")??"—") - @(item.IsCurrentlyWorking?"Present":item.EndDate?.ToString("MMM yyyy")??"—")</span>@if(!string.IsNullOrWhiteSpace(item.EmploymentType)){<span><i class="bi bi-person-workspace"></i>@item.EmploymentType</span>}</div>@if(!string.IsNullOrWhiteSpace(item.Description)){<p class="small soft-muted mt-2 mb-0">@item.Description</p>}</div></article>}</div>}
    </section>

    <section class="student-card p-4 profile-section-card">
      <div class="profile-section-head"><div><span class="profile-kicker">Certificates</span><h2>Certifications & diplomas</h2></div><span class="profile-count">@Model.Certifications.Count record(s)</span></div>
      @if(Model.Certifications.Count==0){<div class="profile-empty"><i class="bi bi-patch-check"></i><div><strong>No certifications added</strong><p>Add diplomas, short courses and professional certificates when applicable.</p></div></div>}
      else{<div class="profile-record-list">@foreach(var item in Model.Certifications){<article class="profile-record"><div class="record-icon"><i class="bi bi-patch-check-fill"></i></div><div class="flex-grow-1"><h3>@item.Title</h3><p class="mb-1">@item.InstituteName</p><div class="record-meta">@if(!string.IsNullOrWhiteSpace(item.Duration)){<span><i class="bi bi-clock"></i>@item.Duration</span>}@if(item.StartDate.HasValue||item.EndDate.HasValue){<span><i class="bi bi-calendar3"></i>@(item.StartDate?.ToString("dd MMM yyyy")??"—") - @(item.EndDate?.ToString("dd MMM yyyy")??"—")</span>}</div></div></article>}</div>}
    </section>
  </div>

  <aside class="col-xl-4">
    <div class="student-card p-4 mb-4 sticky-profile-summary">
      <div class="d-flex justify-content-between align-items-center"><h2 class="section-title mb-0">Profile readiness</h2><strong class="fs-4">@Model.ProfileCompletion%</strong></div>
      <div class="progress progress-thin mt-3"><div class="progress-bar" style="width:@Model.ProfileCompletion%"></div></div>
      <p class="small soft-muted mt-3">Complete identity and domicile information before a high-security examination. Education and experience remain separate reusable records.</p>
      <a asp-action="FaceIdentity" class="btn btn-outline-primary rounded-pill">View identity photos</a>
      <a asp-action="Edit" class="btn btn-outline-primary rounded-pill w-100 mt-2">Complete / update profile</a>
    </div>
    <div class="student-card p-4 mb-4"><h2 class="section-title">Exam history</h2><div class="row g-3 mt-1 text-center"><div class="col-6"><div class="profile-stat">@Model.CompletedExams</div><small>Completed</small></div><div class="col-6"><div class="profile-stat text-warning">@Model.OngoingExams</div><small>Ongoing</small></div><div class="col-6"><div class="profile-stat text-success">@Model.PassedExams</div><small>Passed</small></div><div class="col-6"><div class="profile-stat text-danger">@Model.FailedExams</div><small>Failed</small></div></div><hr/><div class="d-flex justify-content-between"><span class="soft-muted">Average marks</span><strong>@Model.AverageMarks.ToString("0.##")</strong></div><div class="d-flex justify-content-between mt-2"><span class="soft-muted">Pass rate</span><strong>@Model.PassPercentage.ToString("0.##")%</strong></div></div>
    <div class="student-card p-4"><h2 class="section-title">Account security</h2><div class="small soft-muted">Member since</div><strong>@Model.CreatedDate.ToString("dd MMM yyyy")</strong><div class="small soft-muted mt-3">Last login</div><strong>@(Model.LastLoginDate?.ToString("dd MMM yyyy, hh:mm tt")??"—")</strong><div class="small soft-muted mt-3">Testing organization</div><strong>@(Model.TestingOrganization??"—")</strong></div>
  </aside>
</div>
