@model AiExamProctoring.Services.Results.CertificateVerification
@{ViewData["Title"]="Certificate verification";}
<section class="container py-5" style="max-width:760px"><div class="card p-4">
<h1>Certificate verification</h1><h2 class="h4">@Model.Status</h2>
<dl><dt>Record number</dt><dd>@Model.Number</dd><dt>Examination</dt><dd>@Model.Examination</dd>
<dt>Document type</dt><dd>@Model.DocumentType</dd><dt>Issue date (UTC)</dt><dd>@Model.IssuedAtUtc.ToString("dd MMM yyyy")</dd></dl>
<p>This page verifies the document record only. Candidate photographs, identity details and proctoring evidence are private.</p>
</div></section>
