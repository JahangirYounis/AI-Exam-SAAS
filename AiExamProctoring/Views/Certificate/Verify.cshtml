@model AiExamProctoring.Models.ExamResult
@{ ViewData["Title"] = "Certificate verification"; }
<section class="container py-5" style="max-width:760px">
    <div class="card border-0 shadow-sm p-4 p-md-5">
        <span class="text-success fw-bold">Verified examination record</span>
        <h1 class="mt-3">@Model.Attempt!.Student!.FullName</h1>
        <h2 class="h4 text-secondary">@Model.Attempt.Exam!.ExamTitle</h2>
        <dl class="row mt-4">
            <dt class="col-6">Marks</dt><dd class="col-6">@Model.TotalMarksObtained.ToString("0.##") / @Model.TotalMarks.ToString("0.##")</dd>
            <dt class="col-6">Percentage</dt><dd class="col-6">@Model.Percentage.ToString("0.##")%</dd>
            <dt class="col-6">Completed</dt><dd class="col-6">@Model.Attempt.CompletedAt?.ToString("dd MMM yyyy")</dd>
            <dt class="col-6">Record</dt><dd class="col-6">@(Model.CertificateNumber ?? $"EXAM-{Model.ResultId:D8}")</dd>
        </dl>
        <p class="small text-secondary mb-0">Compare these details with the certificate. This page confirms the stored examination result.</p>
    </div>
</section>
