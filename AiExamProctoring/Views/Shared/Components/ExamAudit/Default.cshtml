@model AiExamProctoring.ViewModels.ExamAuditViewModel
@using AiExamProctoring.Models

@{
    var startedCount = Model.Attempts
        .Where(a => a.Status != AttemptStatus.NotStarted)
        .Select(a => a.StudentId)
        .Distinct()
        .Count();

    var completedCount = Model.Attempts
        .Where(a => a.Status == AttemptStatus.Completed || a.Status == AttemptStatus.AutoSubmitted)
        .Select(a => a.StudentId)
        .Distinct()
        .Count();

    var eventCount = Model.Events.Count;
    var examId = int.TryParse(ViewContext.RouteData.Values["id"]?.ToString(), out var parsedId)
        ? (int?)parsedId
        : null;
}

<section class="card border-0 shadow-sm rounded-4 my-4" aria-labelledby="exam-activity-title">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <h2 id="exam-activity-title" class="h5 fw-bold mb-1">Exam activity</h2>
                <p class="small text-secondary mb-0">
                    A simple summary of student participation and recorded monitoring events.
                </p>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-6 col-xl-3">
                <div class="rounded-3 border bg-light p-3 h-100">
                    <div class="small text-secondary">Assigned students</div>
                    <div class="fs-4 fw-bold">@Model.Selected</div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="rounded-3 border bg-light p-3 h-100">
                    <div class="small text-secondary">Started exam</div>
                    <div class="fs-4 fw-bold">@startedCount</div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="rounded-3 border bg-light p-3 h-100">
                    <div class="small text-secondary">Completed exam</div>
                    <div class="fs-4 fw-bold">@completedCount</div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="rounded-3 border bg-light p-3 h-100">
                    <div class="small text-secondary">Recorded incidents</div>
                    <div class="fs-4 fw-bold @(eventCount > 0 ? "text-danger" : "")">@eventCount</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap mb-3">
            <a asp-area="Teacher" asp-controller="Results" asp-action="Index" asp-route-examId="@examId"
               class="btn btn-outline-primary btn-sm">View exam results</a>
            <a asp-area="Teacher" asp-controller="Monitoring" asp-action="Index" asp-route-examId="@examId"
               class="btn btn-outline-secondary btn-sm">View candidate evidence</a>
        </div>

        @if (Model.Attempts.Count == 0 && eventCount == 0)
        {
            <p class="small text-secondary mb-0">No student attempts or monitoring events have been recorded yet.</p>
        }
        else
        {
            <p class="small text-secondary mb-0">
                Use <strong>View exam results</strong> for marks and <strong>View candidate evidence</strong>
                for screenshots, recordings and reviewed alerts.
            </p>
        }

        <details class="mt-3 border-top pt-3">
            <summary class="fw-semibold" style="cursor:pointer">Show detailed history (optional)</summary>

            <div class="mt-3">
                <p class="small mb-2"><strong>Created by:</strong> @Model.Creator</p>

                @if (Model.Team.Count > 0)
                {
                    <p class="small mb-1"><strong>Invited teachers:</strong></p>
                    <ul class="small">
                        @foreach (var teacher in Model.Team)
                        {
                            <li>
                                @(teacher.Teacher?.FullName ?? "Teacher") —
                                @(teacher.AcceptedAtUtc.HasValue
                                                        ? (teacher.IsActive ? "Accepted" : "Access removed")
                                                        : "Invitation pending")
                    </li>
                                        }
                    </ul>
                }

                @if (Model.Attempts.Count > 0)
                {
                    <h3 class="h6 fw-bold mt-3">Student attempts</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr><th>Student</th><th>Attempt</th><th>Marks</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var attempt in Model.Attempts)
                                {
                                    <tr>
                                        <td>@(attempt.Student?.FullName ?? "Unknown")</td>
                                        <td>#@attempt.AttemptId</td>
                                        <td>@attempt.TotalMarksObtained / @attempt.TotalMarks</td>
                                        <td>@attempt.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (eventCount > 0)
                {
                    <h3 class="h6 fw-bold mt-3">Recorded monitoring events</h3>
                    <p class="small text-secondary">AI alerts are observations for teacher review, not automatic proof of cheating.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr><th>Time</th><th>Student</th><th>Event</th><th>Details</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Events)
                                {
                                    <tr>
                                        <td class="text-nowrap">@item.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>@(item.Student?.FullName ?? "Unknown")</td>
                                        <td>@item.AlertTypeDisplay</td>
                                        <td>@item.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </details>
    </div>
</section>