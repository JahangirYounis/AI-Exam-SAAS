@{ ViewData["Title"] = "How It Works"; }
<section class="page-hero"><div class="container"><span class="section-kicker">How it works</span><h1>Follow the steps for your role.</h1><p>You do not need technical knowledge. Open your portal and complete the actions in order.</p></div></section>
<section class="public-section bg-white"><div class="container"><div class="row g-4">
    <div class="col-lg-4"><div class="role-panel h-100"><span class="role-badge">Administrator</span><ol class="process-list"><li><b>Review accounts</b><span>Approve teachers and manage user access.</span></li><li><b>Check the system</b><span>View exams, results and monitoring activity.</span></li><li><b>Handle problems</b><span>Block or restore access when required.</span></li></ol></div></div>
    <div class="col-lg-4"><div class="role-panel h-100"><span class="role-badge">Teacher</span><ol class="process-list"><li><b>Create an exam</b><span>Enter the title, timing, marks and sessions.</span></li><li><b>Add questions</b><span>Select questions from the bank and assign students.</span></li><li><b>Publish and review</b><span>Release the exam, then review attempts and results.</span></li></ol></div></div>
    <div class="col-lg-4"><div class="role-panel h-100"><span class="role-badge">Student</span><ol class="process-list"><li><b>Open an exam</b><span>Choose an available exam from your dashboard.</span></li><li><b>Complete the check</b><span>Allow the camera, microphone and screen when requested.</span></li><li><b>Answer and submit</b><span>Your answers save automatically while you work.</span></li></ol></div></div>
</div></div></section>
<section class="public-section"><div class="container"><div class="section-heading text-center mx-auto"><span class="section-kicker">During an exam</span><h2>Stay on the exam page and follow the instructions</h2><p>Use Previous and Next to move between questions, watch the question palette and submit before time ends. Browser focus/fullscreen controls remain available, while AI decisions are currently inactive.</p></div></div></section>
