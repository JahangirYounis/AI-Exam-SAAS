@{ ViewData["Title"] = "Online examinations"; }
@{ var portal = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Teacher") ? "Teacher" : "Student"; }
<section class="pub-hero container">
 <div><p class="pub-kicker">FOR STUDENTS &amp; TEACHERS</p><h1>Ready for your<br /><em>next exam?</em></h1><p class="pub-lead">Find your exam, check your devices and get started. Teachers can prepare questions, monitor attempts and review results in the same place.</p><div class="pub-actions">
 @if (User.Identity?.IsAuthenticated == true) { <a class="pub-button" asp-area="@portal" asp-controller="Dashboard" asp-action="Index">Open my dashboard <span aria-hidden="true">↗</span></a> }
 else { <a class="pub-button" asp-area="Identity" asp-page="/Account/Login">Sign in to your account <span aria-hidden="true">↗</span></a> }
 <a class="pub-text-link" asp-controller="Home" asp-action="HowItWorks">First time here? Start here →</a></div><p class="pub-small">New to the system? <a asp-area="Identity" asp-page="/Account/Register">Create a student or teacher account</a></p></div>
 <figure class="pub-hero-photo"><img src="~/images/public/student-library.jpg" width="1400" height="2100" fetchpriority="high" alt="A student using a laptop at a library table" /><figcaption>A quiet space. A working device. A good place to begin.</figcaption></figure>
</section>
<section class="pub-band"><div class="container pub-band-grid"><span>Before you start</span><p>Check your exam time</p><p>Keep your device charged</p><p>Test your camera &amp; microphone</p><a asp-controller="Home" asp-action="HowItWorks" asp-fragment="checklist">See the checklist →</a></div></section>
<section class="pub-section container"><div class="pub-heading"><div><p class="pub-kicker">FIND YOUR WAY</p><h2>What would you like to do?</h2></div><p>Choose your role to get to the right workspace.</p></div><div class="pub-roles">
<article><span class="pub-number">01</span><h3>I'm a student</h3><p>Open assigned exams, follow the setup checks and find your published results.</p><a asp-area="Student" asp-controller="Dashboard" asp-action="Index">Go to the student portal →</a></article>
<article><span class="pub-number">02</span><h3>I'm a teacher</h3><p>Build an exam, invite candidates and review live monitoring, evidence and marks.</p><a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">Go to the teacher portal →</a></article>
<article><span class="pub-number">03</span><h3>I manage the system</h3><p>Review teacher accounts and manage access, exam activity and reports.</p><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Go to the admin portal →</a></article>
</div></section>
<section class="pub-section pub-tinted"><div class="container pub-split"><div><p class="pub-kicker">KNOW WHAT TO EXPECT</p><h2>Prepare. Take your exam.<br />Review your result.</h2><p>You will see the instructions and required device checks before entering an exam. During the session, check that your answers show as saved and submit when you finish.</p><a class="pub-text-link" asp-controller="Home" asp-action="HowItWorks">Walk through the steps →</a></div><ol class="pub-steps"><li><strong>Open your examination</strong><p>Sign in and check the date, start time and entry instructions.</p></li><li><strong>Complete the setup</strong><p>Follow identity, camera, microphone and screen-sharing checks as required.</p></li><li><strong>Answer and submit</strong><p>Work through the questions, review your answers and submit the session.</p></li></ol></div></section>
<section class="pub-section container pub-split"><div><p class="pub-kicker">MONITORING, EXPLAINED</p><h2>Clear rules.<br />A chance to be heard.</h2><p>Monitoring observations help teachers review an attempt. Confirmed events can add warnings or pause an exam under its configured rules. An observation alone is not a final finding of misconduct.</p><a class="pub-text-link" asp-controller="Home" asp-action="Faq" asp-fragment="monitoring">Read the monitoring questions →</a></div><aside class="pub-note"><i class="bi bi-life-preserver" aria-hidden="true"></i><h3>Something isn't working?</h3><p>Find practical steps for signing in, device permissions, exam access and interrupted sessions.</p><a class="pub-button pub-button-light" asp-controller="Home" asp-action="Contact">Get help →</a></aside></section>
