@{ ViewData["Title"] = "Help"; }
<section class="page-hero"><div class="container"><span class="section-kicker">Help</span><h1>Having trouble? Check these steps first.</h1><p>Most account and exam-entry problems can be solved with the checks below.</p></div></section>
<section class="public-section bg-white"><div class="container"><div class="row g-4"><div class="col-lg-7"><div class="contact-card"><h2 class="fw-bold">Quick checks</h2><div class="support-checks"><div><i class="bi bi-person-check"></i><span><b>Cannot sign in</b>Check your email and password. A Teacher account must also be approved.</span></div><div><i class="bi bi-camera-video"></i><span><b>Camera or microphone not working</b>Allow permission in the browser and reload the page.</span></div><div><i class="bi bi-clock"></i><span><b>Exam is not visible</b>Check the exam date, start time and your assignment.</span></div><div><i class="bi bi-wifi"></i><span><b>Page is slow</b>Use a stable internet connection and close unnecessary applications.</span></div></div></div></div><div class="col-lg-5"><div class="contact-card dark"><i class="bi bi-headset contact-icon"></i><h3>Contact the administrator</h3><p>If the problem continues, send the following information to your examination or IT support team:</p><ul class="mb-4"><li>Your full name and Candidate ID</li><li>Exam name and date</li><li>A screenshot of the error</li></ul><a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary px-4">Go to Sign In</a></div></div></div></div></section>
