@{ ViewData["Title"] = "Features"; }
<section class="page-hero"><div class="container"><span class="section-kicker">Features</span><h1>Everything needed for an online examination.</h1><p>Each feature is placed in the portal where it is needed, with clear labels and simple actions.</p></div></section>
<section class="public-section bg-white"><div class="container"><div class="feature-matrix">
    <div><i class="bi bi-people"></i><h4>User Management</h4><p>Create accounts, approve teachers, manage students and control access.</p></div>
    <div><i class="bi bi-question-circle"></i><h4>Question Bank</h4><p>Store questions by subject and reuse them in different examinations.</p></div>
    <div><i class="bi bi-journal-plus"></i><h4>Exam Builder</h4><p>Set questions, marks, duration, sessions, breaks and candidate access.</p></div>
    <div><i class="bi bi-device-ssd"></i><h4>Device Check</h4><p>Check the camera, microphone, browser and fullscreen support before an exam starts.</p></div>
    <div><i class="bi bi-shield-check"></i><h4>Review-first AI modules</h4><p>Face identity, behavior and local multilingual speech modules are connected. Object-model training and the final relevance and risk modules remain staged work.</p></div>
    <div><i class="bi bi-save"></i><h4>Automatic Saving</h4><p>Save answers regularly so normal page or connection problems cause less loss.</p></div>
    <div><i class="bi bi-cup-hot"></i><h4>Session Breaks</h4><p>Divide a long exam into parts and allow a controlled break between them.</p></div>
    <div><i class="bi bi-bar-chart"></i><h4>Results and Reports</h4><p>Review marks, answers, historical monitoring records and downloadable result documents.</p></div>
</div></div></section>
